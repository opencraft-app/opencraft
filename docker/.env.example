# Copy this file to .env and replace /home/opencraft with the deployment user's home.
# Host paths and container paths are deliberately separate identities.
OPENCRAFT_HOST_DATA_DIR=/home/opencraft/.opencraft
OPENCRAFT_DATA_DIR=/data/.opencraft
OPENCRAFT_HOST_WORKSPACE_DIR=/home/opencraft/opencraft-workspaces
OPENCRAFT_WORKSPACE_DIR=/data
# Match the user that runs bin/opencraft-host: id -u / id -g.
OPENCRAFT_UID=1000
OPENCRAFT_GID=1000
OPENCRAFT_PORT=10000
OPENCRAFT_IMAGE=opencraft:local
OPENCRAFT_PLATFORM=linux/amd64
# Hands is one shared resource plane. Brain declares the identical sandbox budget.
OPENCRAFT_HANDS_CPUS=4.0
OPENCRAFT_HANDS_MEMORY_BYTES=8589934592
