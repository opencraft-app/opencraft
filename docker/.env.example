# Absolute paths on the Linux host. The native Host and container use the same paths.
OPENCRAFT_DATA_DIR=/srv/opencraft/data
OPENCRAFT_WORKSPACE_DIR=/srv/opencraft/workspaces
# Match the user that runs bin/opencraft-host: id -u / id -g.
OPENCRAFT_UID=1000
OPENCRAFT_GID=1000
OPENCRAFT_PORT=10000
OPENCRAFT_IMAGE=opencraft:local
OPENCRAFT_PLATFORM=linux/arm64
