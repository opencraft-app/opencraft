{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@vela/client-core": [
        "../../packages/client-core/src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "strict": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "index.ts"
  ]
}
