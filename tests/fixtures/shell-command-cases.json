    },
    {
      "test": "cd_then_cat_is_single_read",
      "argv": [
        "cd",
        "foo",
        "&&",
        "cat",
        "foo.txt"
      ],
      "expected": [
        {
          "type": "read",
          "cmd": "cat foo.txt",
          "name": "foo.txt",
          "path": "foo/foo.txt"
        }
      ]
    },
    {
      "test": "cd_with_double_dash_then_cat_is_read",
      "argv": [
        "cd",
        "--",
        "-weird",
        "&&",
        "cat",
        "foo.txt"
      ],
      "expected": [
        {
          "type": "read",
          "cmd": "cat foo.txt",
          "name": "foo.txt",
          "path": "-weird/foo.txt"
        }
      ]
    },
    {
      "test": "cd_with_multiple_operands_uses_last",
      "argv": [
        "cd",
        "dir1",
        "dir2",
        "&&",
        "cat",
        "foo.txt"
      ],
      "expected": [
        {
          "type": "read",
          "cmd": "cat foo.txt",
          "name": "foo.txt",
          "path": "dir2/foo.txt"
        }
      ]
    },
    {
      "test": "collapses_pipeline_with_helper_when_later_stage_is_unknown",
