    {
      "test": "bash_cd_then_bar_is_same_as_bar",
      "argv": [
        "bash",
        "-lc",
        "cd foo && bar"
      ],
      "expected": [
        {
          "type": "unknown",
          "cmd": "cd foo && bar"
        }
      ]
    },
    {
      "test": "bash_cd_then_cat_is_read",
      "argv": [
        "bash",
        "-lc",
        "cd foo && cat foo.txt"
      ],
      "expected": [
        {
          "type": "read",
          "cmd": "cat foo.txt",
          "name": "foo.txt",
          "path": "foo/foo.txt"
        }
      ]
    },
    {
      "test": "bash_dash_c_pipeline_parsing",
      "argv": [
        "bash",
        "-c",
        "rg --files | head -n 1"
      ],
      "expected": [
        {
          "type": "list_files",
          "cmd": "rg --files",
          "path": null
        }
      ]
    },
    {
      "test": "bash_lc_redirect_not_quoted",
      "argv": [
        "bash",
        "-lc",
        "echo foo > bar"
      ],
      "expected": [
        {
          "type": "unknown",
          "cmd": "echo foo > bar"
        }
      ]
    },
    {
      "test": "bin_bash_lc_sed",
      "argv": [
        "/bin/bash",
        "-lc",
        "sed -n 1,10p Cargo.toml"
      ],
      "expected": [
        {
          "type": "read",
          "cmd": "sed -n '1,10p' Cargo.toml",
          "name": "Cargo.toml",
          "path": "Cargo.toml"
        }
      ]
    },
    {
      "test": "bin_zsh_lc_sed",
