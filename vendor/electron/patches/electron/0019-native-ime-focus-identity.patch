+void ElectronApiServiceImpl::GetNativeImeFocusForTesting(
+    GetNativeImeFocusForTestingCallback callback) {
+  auto result = mojom::NativeImeContext::New();
+  result->reason = "no-native-editor";
+  auto* frame = render_frame()->GetWebFrame();
+  auto* input = frame ? frame->GetInputMethodController() : nullptr;
+  if (!input || !frame->View() || frame->View()->FocusedFrame() != frame) {
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  // Native editor identity only: no layout, value/selection snapshot, native
+  // edit-token mutation or composition ownership change. Existing preedit is
+  // allowed; this observation cannot acquire its write authority.
+  const auto state = input->GetNativeImeStateForTesting();
+  const bool text_type = (state.input_type >= 1 && state.input_type <= 7) ||
+                         state.input_type == 14 || state.input_type == 15;
+  if (!state.supported || state.busy || !text_type || state.node_id <= 0) {
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  result->available = true;
+  result->reason.clear();
+  result->target_identity = frame->GetDocument().Token().ToString() + ":" +
+                            base::NumberToString(state.node_id);
+  result->focus_identity = result->target_identity + ":" +
+                           base::NumberToString(state.focus_generation) + ":" +
+                           base::NumberToString(state.input_type);
+  result->input_type = state.input_type;
+  std::move(callback).Run(std::move(result));
+}
+
+void ElectronApiServiceImpl::GetNativeImeFocusForInputForTesting(
+    const std::string& ticket,
+    GetNativeImeFocusForInputForTestingCallback callback) {
+  auto result = mojom::NativeImeContext::New();
+  result->reason = "input-context-mismatch";
+  const auto first = ticket.find(':');
+  const auto second =
+      first == std::string::npos ? first : ticket.find(':', first + 1);
+  uint64_t id = 0;
+  int64_t timestamp = 0;
+  const auto prefix = ticket.substr(0, first);
+  const int kind = prefix == "mouse"   ? 1
+                   : prefix == "key"   ? 2
+                   : prefix == "touch" ? 3
+                                       : 0;
+  if (ticket == native_ime_last_activation_ticket_ || ticket.size() > 128 ||
+      !kind || first == std::string::npos || second == std::string::npos ||
+      !base::StringToUint64(ticket.substr(first + 1, second - first - 1), &id) ||
+      !base::StringToInt64(ticket.substr(second + 1), &timestamp) || !id ||
+      timestamp <= 0) {
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  auto* frame = render_frame()->GetWebFrame();
+  auto* input = frame ? frame->GetInputMethodController() : nullptr;
+  if (!input || !frame->View() || frame->View()->FocusedFrame() != frame) {
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  // Native editor identity only: no layout, value/selection snapshot, native
+  // edit-token mutation or composition ownership change. Existing preedit is
+  // allowed; this observation cannot acquire its write authority.
+  const auto state = input->GetNativeImeStateForTesting();
+  const bool text_type = (state.input_type >= 1 && state.input_type <= 7) ||
+                         state.input_type == 14 || state.input_type == 15;
+  if (!state.supported || state.busy || !text_type || state.node_id <= 0 ||
+      state.activation_id != id || state.activation_timestamp_us != timestamp ||
+      state.activation_kind != kind ||
+      state.node_id != state.activation_node_id ||
+      state.input_type != state.activation_input_type) {
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  result->available = true;
+  result->reason.clear();
+  result->target_identity = frame->GetDocument().Token().ToString() + ":" +
+                            base::NumberToString(state.node_id);
+  result->focus_identity = result->target_identity + ":" +
+                           base::NumberToString(state.focus_generation) + ":" +
+                           base::NumberToString(state.input_type);
+  result->input_type = state.input_type;
+  native_ime_last_activation_ticket_ = ticket;
+  std::move(callback).Run(std::move(result));
+}
