+mojom::NativeImeContextPtr ElectronApiServiceImpl::CaptureNativeImeContext() {
+  auto result = mojom::NativeImeContext::New();
+  result->reason = "unavailable";
+  native_ime_snapshot_.reset();
+  native_ime_token_.clear();
+  auto* web_frame = render_frame()->GetWebFrame();
+  if (!web_frame || !web_frame->View() ||
+      web_frame->View()->FocusedFrame() != web_frame)
+    return result;
+  auto* input = web_frame->GetInputMethodController();
+  if (!input || !input->GetNativeImeStateForTesting().supported) {
+    result->reason = "unsupported-editor";
+    return result;
+  }
+  const auto state = input->GetNativeImeStateForTesting();
+  if (state.busy) {
+    result->reason = "busy";
+    return result;
+  }
+  const auto document = web_frame->GetDocument().Token().ToString();
+  const uint64_t focus = state.focus_generation;
+  auto weak = GetWeakPtr();
+  auto info = input->TextInputInfo();
+  if (!weak)
+    return result;
+  const auto after = input->GetNativeImeStateForTesting();
+  if (web_frame->GetDocument().Token().ToString() != document ||
+      !web_frame->View() || web_frame->View()->FocusedFrame() != web_frame ||
+      !after.supported || after.busy || after.focus_generation != focus)
+    return result;
+  if (info.node_id == 0 || info.value.length() > 65536 ||
+      (info.type != blink::kWebTextInputTypeText &&
+       info.type != blink::kWebTextInputTypeTextArea &&
+       info.type != blink::kWebTextInputTypeContentEditable)) {
+    result->reason = "unsupported-editor";
+    return result;
+  }
+  const uint64_t composition = after.composition_generation;
+  if (native_ime_composition_document_ != document ||
+      native_ime_owned_focus_generation_ != focus ||
+      native_ime_owned_composition_generation_ != composition ||
+      info.composition_start < 0) {
+    native_ime_composition_id_.clear();
+  }
+  native_ime_document_ = document;
+  native_ime_focus_generation_ = focus;
+  native_ime_composition_generation_ = composition;
+  native_ime_snapshot_ = info;
+  native_ime_token_ = base::UnguessableToken::Create().ToString();
+  result->available = true;
+  result->reason.clear();
+  result->token = native_ime_token_;
+  result->composition_id = native_ime_composition_id_;
+  result->selection_start = info.selection_start;
+  result->selection_end = info.selection_end;
+  result->composition_start = info.composition_start;
+  result->composition_end = info.composition_end;
+  return result;
+}
+
+void ElectronApiServiceImpl::GetNativeImeContextForTesting(
+    GetNativeImeContextForTestingCallback callback) {
+  std::move(callback).Run(CaptureNativeImeContext());
+}
+
+void ElectronApiServiceImpl::ApplyNativeImeForTesting(
+    mojom::NativeImeOperationPtr operation,
+    ApplyNativeImeForTestingCallback callback) {
+  auto result = mojom::NativeImeResult::New();
+  auto finish = [&](const char* status) {
+    result->status = status;
+    result->context = CaptureNativeImeContext();
+    std::move(callback).Run(std::move(result));
+  };
+  if (operation->text.size() > 16384 || operation->token.size() > 128 ||
+      operation->composition_id.size() > 128 ||
+      operation->selection_start < 0 ||
+      operation->selection_end < operation->selection_start ||
+      static_cast<size_t>(operation->selection_end) > operation->text.size() ||
+      (operation->type == mojom::NativeImeOperationType::kCompose &&
+       operation->text.empty()) ||
+      (operation->type == mojom::NativeImeOperationType::kCancel &&
+       !operation->text.empty())) {
+    finish("invalid-operation");
+    return;
+  }
+  if (!native_ime_snapshot_ || operation->token.empty() ||
+      operation->token != native_ime_token_) {
+    finish("stale-target");
+    return;
+  }
+  // Consume before any website handler can run; replays cannot mutate twice.
+  native_ime_token_.clear();
+  const auto expected = *native_ime_snapshot_;
+  auto* web_frame = render_frame()->GetWebFrame();
+  if (!web_frame || !web_frame->View() ||
+      web_frame->View()->FocusedFrame() != web_frame ||
+      web_frame->GetDocument().Token().ToString() != native_ime_document_) {
+    finish("stale-target");
+    return;
+  }
+  auto* input = web_frame->GetInputMethodController();
+  if (!input || !input->GetNativeImeStateForTesting().supported) {
+    finish("unsupported-editor");
+    return;
+  }
+  const auto focus = native_ime_focus_generation_;
+  const auto composition = native_ime_composition_generation_;
+  auto weak = GetWeakPtr();
+  const auto current = input->TextInputInfo();
+  if (!weak) {
+    result->status = "frame-destroyed";
+    result->context = mojom::NativeImeContext::New();
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  const auto state = input->GetNativeImeStateForTesting();
+  if (!state.supported || state.busy ||
+      web_frame->GetDocument().Token().ToString() != native_ime_document_ ||
+      state.focus_generation != focus ||
+      state.composition_generation != composition || !(current == expected)) {
+    finish("context-changed");
+    return;
+  }
+  const bool has_composition = state.has_composition;
+  const bool owns_composition =
+      has_composition && !native_ime_composition_id_.empty() &&
+      operation->composition_id == native_ime_composition_id_ &&
+      native_ime_composition_document_ == native_ime_document_ &&
+      native_ime_owned_focus_generation_ == focus &&
+      native_ime_owned_composition_generation_ == composition;
+  if ((has_composition && !owns_composition) ||
+      (!has_composition && !operation->composition_id.empty()) ||
+      (operation->type == mojom::NativeImeOperationType::kCancel &&
+       !owns_composition)) {
+    finish("composition-mismatch");
+    return;
+  }
+  using NativeOperation =
+      blink::WebInputMethodController::NativeImeOperationForTesting;
+  const auto type = operation->type == mojom::NativeImeOperationType::kCommit
+                        ? NativeOperation::kCommit
+                    : operation->type == mojom::NativeImeOperationType::kCancel
+                        ? NativeOperation::kCancel
+                        : NativeOperation::kCompose;
+  const auto edit = input->ApplyNativeImeForTesting(
+      type, blink::WebString::FromUtf16(operation->text),
+      operation->selection_start, operation->selection_end, expected, focus,
+      composition);
+  result->dispatched = edit.dispatched;
+  if (!weak) {
+    result->status = "frame-destroyed";
+    result->context = mojom::NativeImeContext::New();
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  if (!edit.dispatched) {
+    finish("context-changed");
+    return;
+  }
+  if (edit.accepted && edit.target_valid &&
+      operation->type == mojom::NativeImeOperationType::kCompose &&
+      input->GetNativeImeStateForTesting().has_composition) {
+    if (native_ime_composition_id_.empty())
+      native_ime_composition_id_ = base::UnguessableToken::Create().ToString();
+    native_ime_composition_document_ = native_ime_document_;
+    native_ime_owned_focus_generation_ = focus;
+    native_ime_owned_composition_generation_ =
+        input->GetNativeImeStateForTesting().composition_generation;
+  } else {
+    native_ime_composition_id_.clear();
+  }
+  finish(!edit.target_valid ? "target-changed-during-operation"
+         : edit.accepted    ? "processed"
+                            : "editor-rejected");
+}
