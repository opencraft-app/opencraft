+v8::Local<v8::Promise> WebFrameMain::GetNativeImeContextForTesting(
+    v8::Isolate* isolate) {
+  gin_helper::Promise<base::Value> promise(isolate);
+  auto handle = promise.GetHandle();
+  if (!HasRenderFrame() || Detached()) {
+    promise.RejectWithErrorMessage("Native IME frame is unavailable");
+    return handle;
+  }
+  GetRendererApi()->GetNativeImeContextForTesting(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](gin_helper::Promise<base::Value> promise,
+                 mojom::NativeImeContextPtr context) {
+                if (!context)
+                  promise.RejectWithErrorMessage(
+                      "Native IME renderer disconnected");
+                else
+                  promise.Resolve(NativeImeContextValue(*context));
+              },
+              std::move(promise)),
+          mojom::NativeImeContextPtr()));
+  return handle;
+}
+
+v8::Local<v8::Promise> WebFrameMain::ApplyNativeImeForTesting(
+    v8::Isolate* isolate,
+    const base::DictValue& value) {
+  gin_helper::Promise<base::Value> promise(isolate);
+  auto handle = promise.GetHandle();
+  const auto* type = value.FindString("type");
+  const auto* token = value.FindString("token");
+  const auto* composition = value.FindString("compositionId");
+  const auto* text = value.FindString("text");
+  if (!type || !token || !text || !HasRenderFrame() || Detached() ||
+      text->size() > 65536 || token->size() > 128 ||
+      (composition && composition->size() > 128) ||
+      (*type != "compose" && *type != "commit" && *type != "cancel")) {
+    promise.RejectWithErrorMessage("Invalid experimental native IME operation");
+    return handle;
+  }
+  auto operation = mojom::NativeImeOperation::New();
+  operation->token = *token;
+  operation->composition_id = composition ? *composition : "";
+  operation->text = base::UTF8ToUTF16(*text);
+  operation->selection_start = value.FindInt("selectionStart").value_or(0);
+  operation->selection_end = value.FindInt("selectionEnd").value_or(0);
+  operation->type = *type == "compose" ? mojom::NativeImeOperationType::kCompose
+                    : *type == "commit"
+                        ? mojom::NativeImeOperationType::kCommit
+                        : mojom::NativeImeOperationType::kCancel;
+  GetRendererApi()->ApplyNativeImeForTesting(
+      std::move(operation),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](gin_helper::Promise<base::Value> promise,
+                 mojom::NativeImeResultPtr result) {
+                if (!result) {
+                  promise.RejectWithErrorMessage(
+                      "Native IME renderer disconnected; result unknown");
+                  return;
+                }
+                base::DictValue value;
+                value.Set("status", result->status);
+                value.Set("dispatched", result->dispatched);
+                value.Set("context", NativeImeContextValue(*result->context));
+                promise.Resolve(base::Value(std::move(value)));
+              },
+              std::move(promise)),
+          mojom::NativeImeResultPtr()));
+  return handle;
 }

