+ namespace {
++
++// Keep the media component independent of the Electron executable. Match
++// platform_util::GetXdgAppId(), including its unset-versus-empty semantics.
++std::string GetApplicationIconName() {
++  auto name = base::Environment::Create()->GetVar("CHROME_DESKTOP");
++  if (!name) {
++    return base::CommandLine::ForCurrentProcess()->GetProgram().BaseName().value();
++  }
++  if (name->ends_with(".desktop"))
++    name->resize(name->size() - std::string_view(".desktop").size());
++  return *name;
++}
