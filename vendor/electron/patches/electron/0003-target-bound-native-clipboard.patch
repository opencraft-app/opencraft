++void ClipboardHostImpl::BeginRemoteCopy(BeginRemoteCopyCallback callback) {
++  if (!RemoteClipboard() || remote_copy_ || pending_writes_ != 0 ||
++      render_frame_host().IsInactiveAndDisallowActivation(
