+v8::Local<v8::Promise> WebFrameMain::GetNativeClipboardContextForTesting(
+    v8::Isolate* isolate) {
+  gin_helper::Promise<base::Value> promise(isolate);
+  auto handle = promise.GetHandle();
+  if (!HasRenderFrame() || Detached()) {
+    promise.RejectWithErrorMessage("Copy frame unavailable");
+    return handle;
+  }
+  GetRendererApi()->GetNativeClipboardContextForTesting(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(
+              [](gin_helper::Promise<base::Value> promise,
+                 mojom::NativeClipboardContextPtr context) {
+                if (!context) {
+                  promise.RejectWithErrorMessage("Copy renderer disconnected");
+                  return;
+                }
+                base::DictValue value;
+                value.Set("available", context->available);
+                value.Set("token", context->token);
+                promise.Resolve(base::Value(std::move(value)));
+              },
+              std::move(promise)),
+          mojom::NativeClipboardContextPtr()));
+  return handle;
+}
+
+v8::Local<v8::Promise> WebFrameMain::CopyNativeClipboardForTesting(
+    v8::Isolate* isolate,
+    const std::string& token) {
+  gin_helper::Promise<base::Value> promise(isolate);
+  auto handle = promise.GetHandle();
+  if (!HasRenderFrame() || Detached() || token.empty() || token.size() > 128) {
+    promise.RejectWithErrorMessage("Copy context unavailable");
+    return handle;
+  }
+  GetRendererApi()->CopyNativeClipboardForTesting(
+      token, mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                 base::BindOnce(
+                     [](gin_helper::Promise<base::Value> promise,
+                        mojom::NativeCopyResultPtr result) {
+                       if (!result) {
+                         promise.RejectWithErrorMessage(
+                             "Copy renderer disconnected; result unknown");
+                         return;
+                       }
+                       base::DictValue value;
+                       value.Set("status", result->status);
+                       value.Set("dispatched", result->dispatched);
+                       if (result->has_text)
+                         value.Set("text", base::UTF16ToUTF8(result->text));
+                       if (result->has_html)
+                         value.Set("html", base::UTF16ToUTF8(result->html));
+                       promise.Resolve(base::Value(std::move(value)));
+                     },
+                     std::move(promise)),
+                 mojom::NativeCopyResultPtr()));
+  return handle;
 }

