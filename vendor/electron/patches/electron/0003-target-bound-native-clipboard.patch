++void ClipboardHostImpl::EndRemoteCopy(EndRemoteCopyCallback callback) {
++  if (!remote_copy_ || remote_copy_end_) {
++    auto result = blink::mojom::RemoteCopyResult::New();
++    result->unsupported = true;
++    std::move(callback).Run(std::move(result));
++    return;
++  }
++  remote_copy_end_ = std::move(callback);
++  FinishRemoteCopyIfReady();
++}
++
++void ClipboardHostImpl::FinishRemoteCopyIfReady() {
++  if (!remote_copy_end_ || pending_writes_ != 0) {
++    return;
++  }
++  clipboard_writer_->Reset();
++  pending_commit_write_ = false;
++  if (remote_copy_->text.size() + remote_copy_->html.size() > 65536 ||
++      remote_copy_commits_ > 1) {
++    remote_copy_->unsupported = true;
++  }
++  if (remote_copy_->unsupported || !remote_copy_->committed) {
++    remote_copy_->text.clear();
++    remote_copy_->html.clear();
++    remote_copy_->has_text = remote_copy_->has_html = false;
++  }
++  std::move(remote_copy_end_).Run(std::move(remote_copy_));
++}
