+void ElectronApiServiceImpl::GetNativeClipboardContextForTesting(
+    GetNativeClipboardContextForTestingCallback callback) {
+  auto result = mojom::NativeClipboardContext::New();
+  native_clipboard_token_.clear();
+  auto* frame = render_frame()->GetWebFrame();
+  if (!native_copy_busy_ && frame && frame->View() &&
+      frame->View()->FocusedFrame() == frame) {
+    auto* input = frame->GetInputMethodController();
+    const auto state = input->GetNativeClipboardStateForTesting();
+    if (state.available) {
+      native_clipboard_document_ = frame->GetDocument().Token().ToString();
+      native_clipboard_focus_ = state.focus_generation;
+      native_clipboard_selection_ = state.selection_generation;
+      result->available = true;
+      result->token = native_clipboard_token_ =
+          base::UnguessableToken::Create().ToString();
+    }
+  }
+  std::move(callback).Run(std::move(result));
+}
+
+void ElectronApiServiceImpl::CopyNativeClipboardForTesting(
+    const std::string& token,
+    CopyNativeClipboardForTestingCallback callback) {
+  auto result = mojom::NativeCopyResult::New();
+  result->status = "stale-context";
+  auto* frame = render_frame()->GetWebFrame();
+  const bool valid =
+      !native_copy_busy_ && !token.empty() && token.size() <= 128 &&
+      token == native_clipboard_token_ && frame && frame->View() &&
+      frame->View()->FocusedFrame() == frame &&
+      native_clipboard_document_ == frame->GetDocument().Token().ToString();
+  native_clipboard_token_.clear();
+  if (!valid) {
+    std::move(callback).Run(std::move(result));
+    return;
+  }
+  native_copy_busy_ = true;
+  const auto document = native_clipboard_document_;
+  const auto focus = native_clipboard_focus_;
+  const auto selection = native_clipboard_selection_;
+  frame->GetInputMethodController()->CopyNativeClipboardForTesting(
+      focus, selection,
+      base::BindOnce(
+          [](base::WeakPtr<ElectronApiServiceImpl> self, std::string document,
+             uint64_t focus, uint64_t selection,
+             CopyNativeClipboardForTestingCallback done,
+             blink::WebInputMethodController::NativeCopyResultForTesting
+                 captured) {
+            auto result = mojom::NativeCopyResult::New();
+            result->dispatched = captured.dispatched;
+            result->status = "stale-context";
+            if (self) {
+              self->native_copy_busy_ = false;
+              auto* frame = self->render_frame()->GetWebFrame();
+              const auto state = frame
+                                     ? frame->GetInputMethodController()
+                                           ->GetNativeClipboardStateForTesting()
+                                     : blink::WebInputMethodController::
+                                           NativeClipboardStateForTesting{};
+              const bool valid =
+                  frame && captured.target_valid && state.available &&
+                  frame->GetDocument().Token().ToString() == document &&
+                  state.focus_generation == focus &&
+                  state.selection_generation == selection;
+              if (valid) {
+                result->status = captured.unsupported ? "unsupported-format"
+                                 : !captured.committed || (!captured.has_text &&
+                                                           !captured.has_html)
+                                     ? "no-data"
+                                     : "ok";
+                if (result->status == "ok") {
+                  result->has_text = captured.has_text;
+                  result->has_html = captured.has_html;
+                  result->text = captured.text.Utf16();
+                  result->html = captured.html.Utf16();
+                }
+              }
+            }
+            std::move(done).Run(std::move(result));
+          },
+          GetWeakPtr(), document, focus, selection, std::move(callback)));
 }

