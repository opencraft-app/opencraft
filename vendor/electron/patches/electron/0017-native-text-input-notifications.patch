 namespace {
 
+// Observation lifetime belongs to the native WebContents, not a renderer view.
+// Notify on the next UI task so JavaScript cannot re-enter TextInputManager's
+// observer iteration or retain a pointer to an unregistering view.
+constexpr char kNativeTextInputObservationKey = 0;
+
+class NativeTextInputObservation final : public base::SupportsUserData::Data,
+                                        public content::WebContentsObserver,
+                                        public content::TextInputManager::Observer {
+ public:
+  using content::WebContentsObserver::OnTextSelectionChanged;
+
+  NativeTextInputObservation(content::WebContents* contents,
+                             content::TextInputManager* manager,
+                             base::RepeatingClosure notify)
+      : content::WebContentsObserver(contents),
+        manager_(manager),
+        notify_(std::move(notify)) {
+    manager_->AddObserver(this);
+  }
+
+  ~NativeTextInputObservation() override { Stop(); }
+
+  bool Observes(content::TextInputManager* manager) const {
+    return manager_ == manager;
+  }
+
+  void WebContentsDestroyed() override { Stop(); }
+
+  void OnFocusChangedInPage(const content::FocusedNodeDetails&) override {
+    QueueNotification();
+  }
+
+  void OnUpdateTextInputStateCalled(content::TextInputManager*,
+                                    content::RenderWidgetHostViewBase*,
+                                    bool) override {
+    QueueNotification();
+  }
+  void OnImeCancelComposition(content::TextInputManager*,
+                              content::RenderWidgetHostViewBase*) override {
+    QueueNotification();
+  }
+  void OnSelectionBoundsChanged(content::TextInputManager*,
+                                content::RenderWidgetHostViewBase*) override {
+    QueueNotification();
+  }
+  void OnImeCompositionRangeChanged(content::TextInputManager*,
+                                    content::RenderWidgetHostViewBase*,
+                                    bool) override {
+    QueueNotification();
+  }
+  void OnTextSelectionChanged(content::TextInputManager*,
+                              content::RenderWidgetHostViewBase*) override {
+    QueueNotification();
+  }
+  void OnFocusedInputElementChanged(content::TextInputManager*,
+                                    content::RenderWidgetHostViewBase*) override {
+    QueueNotification();
+  }
+
+ private:
+  void Stop() {
+    weak_factory_.InvalidateWeakPtrs();
+    pending_ = false;
+    if (manager_) {
+      manager_->RemoveObserver(this);
+      manager_ = nullptr;
+    }
+    notify_.Reset();
+    Observe(nullptr);
+  }
+
+  void QueueNotification() {
+    if (!manager_ || pending_)
+      return;
+    pending_ = true;
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(&NativeTextInputObservation::Notify,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void Notify() {
+    pending_ = false;
+    auto notify = notify_;
+    // A listener may disable observation or destroy its WebContents.
+    // Keep the closure locally and do not access this object after running it.
+    notify.Run();
+  }
+
+  raw_ptr<content::TextInputManager> manager_;
+  base::RepeatingClosure notify_;
+  bool pending_ = false;
+  base::WeakPtrFactory<NativeTextInputObservation> weak_factory_{this};
+};
