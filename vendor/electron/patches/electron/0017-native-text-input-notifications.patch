+bool WebContents::SetNativeTextInputStateObservation(bool enabled) {
+  auto* contents = web_contents();
+  if (!contents)
+    return false;
+  if (!enabled) {
+    contents->RemoveUserData(&kNativeTextInputObservationKey);
+    return true;
+  }
+  auto* view = static_cast<content::RenderWidgetHostViewBase*>(
+      contents->GetRenderWidgetHostView());
+  auto* manager = view ? view->GetTextInputManager() : nullptr;
+  if (!manager)
+    return false;
+  auto* existing = static_cast<NativeTextInputObservation*>(
+      contents->GetUserData(&kNativeTextInputObservationKey));
+  if (existing && existing->Observes(manager))
+    return true;
+  contents->RemoveUserData(&kNativeTextInputObservationKey);
+  contents->SetUserData(
+      &kNativeTextInputObservationKey,
+      std::make_unique<NativeTextInputObservation>(
+          contents, manager,
+          base::BindRepeating(
+              [](base::WeakPtr<WebContents> contents) {
+                if (contents)
+                  contents->Emit("native-text-input-state-changed");
+              },
+              GetWeakPtr())));
+  return true;
+}
