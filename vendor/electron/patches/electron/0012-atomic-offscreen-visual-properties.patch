@@ -1000,6 +1006,10 @@ void OffScreenRenderWidgetHostView::ResizeRootLayer(bool force) {
   // DelegatedFrameHost, so it must have SynchronizeVisualProperties called
   // after.
   if (render_widget_host_) {
+    // UpdateScreenInfo synchronizes through NotifyScreenInfoChanged. Suppress
