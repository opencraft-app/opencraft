diff --git a/patches/chromium/.patches b/patches/chromium/.patches
--- a/patches/chromium/.patches
+++ b/patches/chromium/.patches
@@ -258,3 +258,4 @@
 feat_remote_tab_native_clipboard.patch
 fix_component_pulseaudio_embedder_boundary.patch
 fix_gtk_dialog_dynamic_symbols.patch
