+void ElectronApiServiceImpl::GetNativeImeContextForInputForTesting(
+    const std::string& ticket,
+    GetNativeImeContextForInputForTestingCallback callback) {
+  auto unavailable = mojom::NativeImeContext::New();
+  unavailable->reason = "input-context-mismatch";
+  const auto first = ticket.find(':');
+  const auto second =
+      first == std::string::npos ? first : ticket.find(':', first + 1);
+  uint64_t id = 0;
+  int64_t timestamp = 0;
+  const auto prefix = ticket.substr(0, first);
+  const int kind = prefix == "mouse"   ? 1
+                   : prefix == "key"   ? 2
+                   : prefix == "touch" ? 3
+                                       : 0;
+  if (ticket == native_ime_last_activation_ticket_ || ticket.size() > 128 ||
+      !kind || first == std::string::npos || second == std::string::npos ||
+      !base::StringToUint64(ticket.substr(first + 1, second - first - 1),
+                            &id) ||
+      !base::StringToInt64(ticket.substr(second + 1), &timestamp) || !id ||
+      timestamp <= 0) {
+    std::move(callback).Run(std::move(unavailable));
+    return;
+  }
+  auto* frame = render_frame()->GetWebFrame();
+  auto* input = frame ? frame->GetInputMethodController() : nullptr;
+  const auto matches = [&](const auto& state) {
+    return state.supported && !state.busy && !state.has_composition &&
+           state.activation_id == id &&
+           state.activation_timestamp_us == timestamp &&
+           state.activation_kind == kind;
+  };
+  if (!input) {
+    unavailable->reason = "input-target-unavailable";
+    std::move(callback).Run(std::move(unavailable));
+    return;
+  }
+  const auto activation = input->GetNativeImeStateForTesting();
+  if (!matches(activation)) {
+    unavailable->reason = !activation.supported ? "unsupported-editor"
+                          : activation.busy || activation.has_composition
+                              ? "composition-busy"
+                          : activation.activation_id != id ? "input-id-mismatch"
+                          : activation.activation_timestamp_us != timestamp
+                              ? "input-time-mismatch"
+                              : "input-kind-mismatch";
+    std::move(callback).Run(std::move(unavailable));
+    return;
+  }
+  auto weak = GetWeakPtr();
+  auto context = CaptureNativeImeContext();
+  if (!weak) {
+    std::move(callback).Run(std::move(unavailable));
+    return;
+  }
+  frame = render_frame()->GetWebFrame();
+  input = frame ? frame->GetInputMethodController() : nullptr;
+  if (!input || !context->available || !native_ime_snapshot_ ||
+      native_ime_snapshot_->node_id != activation.activation_node_id ||
+      static_cast<int>(native_ime_snapshot_->type) !=
+          activation.activation_input_type ||
+      !matches(input->GetNativeImeStateForTesting())) {
+    native_ime_token_.clear();
+    std::move(callback).Run(std::move(unavailable));
+    return;
+  }
+  native_ime_last_activation_ticket_ = ticket;
+  std::move(callback).Run(std::move(context));
+}
