+v8::Local<v8::Promise> WebContents::SendInputEventWithNativeInputTicket(
+    v8::Isolate* isolate,
+    v8::Local<v8::Value> input_event) {
+  gin_helper::Promise<base::Value> promise(isolate);
+  auto handle = promise.GetHandle();
+  auto* view = web_contents()->GetRenderWidgetHostView();
+  if (!view) {
+    promise.RejectWithErrorMessage("Native input view unavailable");
+    return handle;
+  }
+  auto* existing = static_cast<NativeInputTicketWaiter*>(
+      web_contents()->GetUserData(&kNativeInputTicketWaiterKey));
+  if (existing && existing->pending()) {
+    promise.RejectWithErrorMessage(
+        "Native input acknowledgement already pending");
+    return handle;
+  }
+  auto* host = view->GetRenderWidgetHost();
+  auto type = gin::GetWebInputEventType(isolate, input_event);
+  const auto id = base::trace_event::GetNextGlobalTraceId();
+  ui::LatencyInfo latency;
+  latency.set_trace_id(static_cast<int64_t>(id));
+  const auto make_ticket = [&](const char* kind, base::TimeTicks time) {
+    return std::string(kind) + ":" + base::NumberToString(id) + ":" +
+           base::NumberToString(time.since_origin().InMicroseconds());
+  };
+  if (type == blink::WebInputEvent::Type::kMouseUp) {
+    blink::WebMouseEvent event;
+    if (!gin::ConvertFromV8(isolate, input_event, &event)) {
+      promise.RejectWithErrorMessage("Invalid native mouse activation");
+      return handle;
+    }
+    event.SetTimeStamp(ui::EventTimeForNow());
+    auto waiter = std::make_unique<NativeInputTicketWaiter>(
+        web_contents(), event.GetType(), event.TimeStamp(),
+        make_ticket("mouse", event.TimeStamp()), std::move(promise));
+    auto pending = waiter->GetWeakPtr();
+    web_contents()->SetUserData(&kNativeInputTicketWaiterKey,
+                                std::move(waiter));
+    bool frame_route = true;
+    if (IsOffScreen()) {
+      frame_route =
+          GetOffScreenRenderWidgetHostView()->SendMouseEvent(event, latency);
+    } else {
+      static_cast<content::RenderWidgetHostImpl*>(host)
+          ->ForwardMouseEventWithLatencyInfo(event, latency);
+    }
+    if (pending)
+      pending->DidDispatch(frame_route);
+    return handle;
+  }
+  if (type == blink::WebInputEvent::Type::kKeyDown ||
+      type == blink::WebInputEvent::Type::kRawKeyDown) {
+    input::NativeWebKeyboardEvent event(
+        blink::WebInputEvent::Type::kRawKeyDown,
+        blink::WebInputEvent::Modifiers::kNoModifiers, ui::EventTimeForNow());
+    if (!gin::ConvertFromV8(isolate, input_event, &event)) {
+      promise.RejectWithErrorMessage("Invalid native keyboard activation");
+      return handle;
+    }
+    event.SetType(blink::WebInputEvent::Type::kRawKeyDown);
+    auto* widget = static_cast<content::RenderWidgetHostImpl*>(host);
+    auto* delegate = widget->delegate();
+    auto* focused =
+        delegate ? delegate->GetFocusedRenderWidgetHost(widget) : nullptr;
+    if (!focused) {
+      promise.RejectWithErrorMessage("Native focused input view unavailable");
+      return handle;
+    }
+    auto waiter = std::make_unique<NativeInputTicketWaiter>(
+        web_contents(), event.GetType(), event.TimeStamp(),
+        make_ticket("key", event.TimeStamp()), std::move(promise));
+    waiter->ObserveTarget(focused);
+    auto pending = waiter->GetWeakPtr();
+    web_contents()->SetUserData(&kNativeInputTicketWaiterKey,
+                                std::move(waiter));
+    focused->ForwardKeyboardEventWithLatencyInfo(event, latency);
+    if (pending)
+      pending->DidDispatch(true);
+    return handle;
+  }
+  promise.RejectWithErrorMessage(
+      "Native input ticket requires mouseUp or keyDown");
+  return handle;
+}
