+base::DictValue WebContents::GetNativeTextInputState() {
+  base::DictValue result;
+  result.Set("observationOnly", true);
+  result.Set("coordinateSpace", "root-viewport-dip");
+  result.Set("active", false);
+  if (!web_contents())
+    return result;
+
+  auto* view = static_cast<content::RenderWidgetHostViewBase*>(
+      web_contents()->GetRenderWidgetHostView());
+  auto* manager = view ? view->GetTextInputManager() : nullptr;
+  const auto* state = manager ? manager->GetTextInputState() : nullptr;
+  if (!state)
+    return result;
+
+  auto range_value = [](const gfx::Range& range) {
+    base::DictValue value;
+    value.Set("start", static_cast<double>(range.start()));
+    value.Set("end", static_cast<double>(range.end()));
+    return value;
+  };
+  result.Set("active", state->type != ui::TEXT_INPUT_TYPE_NONE);
+  result.Set("nodeId", state->node_id);
+  result.Set("type", static_cast<int>(state->type));
+  result.Set("mode", static_cast<int>(state->mode));
+  result.Set("password", state->type == ui::TEXT_INPUT_TYPE_PASSWORD);
+  result.Set("selection", range_value(state->selection));
+  if (state->composition)
+    result.Set("composition", range_value(*state->composition));
+
+  std::optional<gfx::Rect> caret = manager->GetTextSelectionBounds();
+  if (!caret) {
+    const auto* region = manager->GetSelectionRegion();
+    if (region && region->focus.GetHeight() > 0) {
+      caret = gfx::Rect(region->focus.edge_start_rounded().x(),
+                        region->focus.edge_start_rounded().y(), 0,
+                        region->focus.GetHeight());
+    }
+  }
+  if (caret) {
+    base::DictValue bounds;
+    bounds.Set("x", caret->x());
+    bounds.Set("y", caret->y());
+    bounds.Set("width", caret->width());
+    bounds.Set("height", caret->height());
+    result.Set("caretBounds", std::move(bounds));
+  }
+  return result;
+}
