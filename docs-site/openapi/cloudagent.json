{
  "components": {
    "parameters": {
      "RunID": {
        "in": "path",
        "name": "run_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "SessionID": {
        "in": "path",
        "name": "session_id",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "CancelRunResponse": {
        "properties": {
          "cancelled": {
            "type": "boolean"
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "cancelled"
        ],
        "type": "object"
      },
      "Capabilities": {
        "properties": {
          "endpoints": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "object": {
            "const": "cloudagent.capabilities",
            "type": "string"
          },
          "protocol": {
            "const": "cloudagent.session_events",
            "type": "string"
          },
          "run_protocol": {
            "type": "boolean"
          },
          "session_event_protocol": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "object",
          "protocol",
          "version",
          "features",
          "endpoints"
        ],
        "type": "object"
      },
      "CreateSessionRequest": {
        "properties": {
          "agent_version": {
            "default": "builtin.v1",
            "type": "string"
          },
          "cwd": {
            "default": "/workspace",
            "type": "string"
          },
          "workspace_version": {
            "default": "builtin.v1",
            "type": "string"
          }
        },
        "type": "object"
      },
      "EventList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/RunEvent"
            },
            "type": "array"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/RunEvent"
            },
            "type": "array"
          },
          "object": {
            "const": "list",
            "type": "string"
          },
          "run": {
            "$ref": "#/components/schemas/Run"
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      },
      "Run": {
        "properties": {
          "created_at": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "last_seq": {
            "type": "integer"
          },
          "output_text": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "stop_reason": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status"
        ],
        "type": "object"
      },
      "RunEvent": {
        "properties": {
          "content": {},
          "error": {},
          "id": {
            "description": "Stable SSE event id with numeric sequence suffix.",
            "type": "string"
          },
          "input": {},
          "is_error": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "seq": {
            "type": "integer"
          },
          "session_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "stop_reason": {},
          "thinking": {
            "type": "string"
          },
          "tool_use_id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "user.message",
              "agent.thinking",
              "agent.message",
              "agent.tool_use",
              "agent.tool_result",
              "session.status_idle",
              "session.error",
              "heartbeat"
            ],
            "type": "string"
          }
        },
        "required": [
          "seq",
          "type",
          "run_id"
        ],
        "type": "object"
      },
      "RunList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Run"
            },
            "type": "array"
          },
          "object": {
            "const": "list",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ],
        "type": "object"
      },
      "RunResult": {
        "properties": {
          "error": {
            "type": "string"
          },
          "output_text": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "status"
        ],
        "type": "object"
      },
      "Session": {
        "properties": {
          "closed": {
            "type": "boolean"
          },
          "cwd": {
            "type": "string"
          },
          "runtime_generation": {
            "type": "integer"
          },
          "session_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "session_id"
        ],
        "type": "object"
      },
      "SessionList": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "type": "array"
          },
          "object": {
            "const": "list",
            "type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ],
        "type": "object"
      },
      "SubmitRunRequest": {
        "properties": {
          "cwd": {
            "default": "/workspace",
            "type": "string"
          },
          "inbox_mode": {
            "enum": [
              "prompt",
              "steer",
              "follow_up"
            ],
            "type": "string"
          },
          "run_id": {
            "description": "Legacy idempotency key field. The server still returns its own durable `run_id`. 兼容旧客户端的幂等 key 字段；服务端仍返回自己的持久化 `run_id`。",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "SubmitSessionEventsRequest": {
        "properties": {
          "events": {
            "items": {
              "properties": {
                "client_event_id": {
                  "type": "string"
                },
                "content": {
                  "items": {
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "type": {
                        "enum": [
                          "text"
                        ],
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "text"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "type": {
                  "enum": [
                    "user.message"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "type",
                "content"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "tenantProjectScope": {
        "description": "Use together with X-Project-ID.",
        "in": "header",
        "name": "X-Tenant-ID",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Qoder-like CloudAgent HTTP protocol for sessions, public events, replay, and SSE streaming. 类 Qoder 的 CloudAgent HTTP 协议，用于会话、公开事件、回放和 SSE 流式读取。",
    "title": "CloudAgent Session Events API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/cloudagent/capabilities": {
      "get": {
        "description": "Probe CloudAgent HTTP session-event protocol support and feature flags. 探测 CloudAgent HTTP 会话事件协议支持和功能开关。",
        "operationId": "getCloudAgentCapabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "CloudAgent capability metadata. CloudAgent 能力元数据。"
          }
        },
        "summary": "Get CloudAgent capabilities",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/runs": {
      "get": {
        "description": "List caller-scoped durable runs, optionally filtered by session. 列出调用方作用域内的持久化运行，可按会话过滤。",
        "operationId": "listCloudAgentRuns",
        "parameters": [
          {
            "in": "query",
            "name": "session_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunList"
                }
              }
            },
            "description": "Caller-scoped run list. 调用方作用域内的运行列表。"
          }
        },
        "summary": "List CloudAgent runs",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/runs/{run_id}": {
      "get": {
        "description": "Read durable run status. 读取持久化运行状态。",
        "operationId": "getCloudAgentRun",
        "parameters": [
          {
            "$ref": "#/components/parameters/RunID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            },
            "description": "CloudAgent response. CloudAgent 响应。"
          }
        },
        "summary": "Get CloudAgent run",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/runs/{run_id}/cancel": {
      "post": {
        "description": "Request cancellation for a durable run. 请求取消持久化运行。",
        "operationId": "cancelCloudAgentRun",
        "parameters": [
          {
            "$ref": "#/components/parameters/RunID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelRunResponse"
                }
              }
            },
            "description": "Cancellation request result. 取消请求结果。"
          }
        },
        "summary": "Cancel CloudAgent run",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/runs/{run_id}/events": {
      "get": {
        "description": "Replay run events after a committed sequence number. When `stream=true`, responses are Server-Sent Events with public CloudAgent event payloads. 在已提交序号之后回放运行事件；`stream=true` 时响应为 Server-Sent Events，并承载 CloudAgent 公开事件。",
        "operationId": "getCloudAgentRunEvents",
        "parameters": [
          {
            "$ref": "#/components/parameters/RunID"
          },
          {
            "in": "query",
            "name": "after_seq",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "SSE event id resume cursor. If present and `after_seq` is absent, the numeric suffix is used as the sequence cursor. SSE 事件 ID 恢复游标；当缺少 `after_seq` 时，使用 ID 的数字后缀作为序号游标。",
            "in": "query",
            "name": "after_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Standard SSE resume header used when `after_seq` and `after_id` are absent. 标准 SSE 恢复 header；当 `after_seq` 和 `after_id` 都缺失时使用。",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "stream",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "description": "Server-Sent Events. Each `data:` payload is a CloudAgent public event JSON object.",
                  "type": "string"
                }
              }
            },
            "description": "Public events as Server-Sent Events. 以 Server-Sent Events 返回公开事件。"
          }
        },
        "summary": "Replay or stream CloudAgent run events",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/runs/{run_id}/result": {
      "get": {
        "description": "Read the final durable run result. 读取最终持久化运行结果。",
        "operationId": "getCloudAgentRunResult",
        "parameters": [
          {
            "$ref": "#/components/parameters/RunID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResult"
                }
              }
            },
            "description": "Final durable run result. 最终持久化运行结果。"
          }
        },
        "summary": "Get CloudAgent run result",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/sessions": {
      "get": {
        "description": "List caller-scoped CloudAgent sessions. 列出调用方作用域内的 CloudAgent 会话。",
        "operationId": "listCloudAgentSessions",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionList"
                }
              }
            },
            "description": "Caller-scoped session list. 调用方作用域内的会话列表。"
          }
        },
        "summary": "List CloudAgent sessions",
        "tags": [
          "CloudAgent"
        ]
      },
      "post": {
        "description": "Create a CloudAgent session in the caller scope. 在调用方作用域内创建 CloudAgent 会话。",
        "operationId": "createCloudAgentSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "description": "CloudAgent session. CloudAgent 会话。"
          }
        },
        "summary": "Create CloudAgent session",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/sessions/{session_id}": {
      "get": {
        "description": "Load a caller-scoped CloudAgent session. 加载调用方作用域内的 CloudAgent 会话。",
        "operationId": "loadCloudAgentSession",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          },
          {
            "in": "query",
            "name": "cwd",
            "required": false,
            "schema": {
              "default": "/workspace",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "description": "CloudAgent session. CloudAgent 会话。"
          }
        },
        "summary": "Load CloudAgent session",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/sessions/{session_id}/close": {
      "post": {
        "description": "Persist and release the runtime for a caller-scoped CloudAgent session without deleting the session identity. 贮藏并释放调用方作用域内 CloudAgent 会话的运行时，但不删除会话身份。",
        "operationId": "closeCloudAgentSession",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "description": "CloudAgent session. CloudAgent 会话。"
          }
        },
        "summary": "Close CloudAgent session runtime",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/sessions/{session_id}/events": {
      "get": {
        "description": "Replay public session events after a committed cursor. 按游标回放公开会话事件。",
        "operationId": "listCloudAgentSessionEvents",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          },
          {
            "in": "query",
            "name": "after_seq",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "SSE event id resume cursor. If present and `after_seq` is absent, the numeric suffix is used as the sequence cursor. SSE 事件 ID 恢复游标；当缺少 `after_seq` 时，使用 ID 的数字后缀作为序号游标。",
            "in": "query",
            "name": "after_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Standard SSE resume header used when `after_seq` and `after_id` are absent. 标准 SSE 恢复 header；当 `after_seq` 和 `after_id` 都缺失时使用。",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventList"
                }
              }
            },
            "description": "Public session events. 公开会话事件。"
          }
        },
        "summary": "List CloudAgent session events",
        "tags": [
          "CloudAgent"
        ]
      },
      "post": {
        "description": "Append public events, currently `user.message`, to a CloudAgent session. The gateway creates an internal run ledger entry. 向 CloudAgent 会话追加公开事件，目前支持 `user.message`；Gateway 会创建内部 run ledger。",
        "operationId": "submitCloudAgentSessionEvents",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          },
          {
            "description": "Caller retry key scoped by tenant, project, and session. 调用方重试 key，作用域为租户、项目和会话。",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitSessionEventsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventList"
                }
              }
            },
            "description": "Public session events. 公开会话事件。"
          }
        },
        "summary": "Submit CloudAgent session events",
        "tags": [
          "CloudAgent"
        ]
      }
    },
    "/v1/cloudagent/sessions/{session_id}/events/stream": {
      "get": {
        "description": "Stream public session events with Server-Sent Events. 使用 Server-Sent Events 读取公开会话事件流。",
        "operationId": "streamCloudAgentSessionEvents",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionID"
          },
          {
            "in": "query",
            "name": "after_seq",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "SSE event id resume cursor. If present and `after_seq` is absent, the numeric suffix is used as the sequence cursor. SSE 事件 ID 恢复游标；当缺少 `after_seq` 时，使用 ID 的数字后缀作为序号游标。",
            "in": "query",
            "name": "after_id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Standard SSE resume header used when `after_seq` and `after_id` are absent. 标准 SSE 恢复 header；当 `after_seq` 和 `after_id` 都缺失时使用。",
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "description": "Server-Sent Events. Each `data:` payload is a CloudAgent public event JSON object.",
                  "type": "string"
                }
              }
            },
            "description": "Public events as Server-Sent Events. 以 Server-Sent Events 返回公开事件。"
          }
        },
        "summary": "Stream CloudAgent session events",
        "tags": [
          "CloudAgent"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "tenantProjectScope": []
    }
  ],
  "servers": [
    {
      "description": "Devcloud internal endpoint / Devcloud 内网入口",
      "url": "http://21.6.84.6"
    },
    {
      "description": "Devcloud in-cluster endpoint / Devcloud 集群内入口",
      "url": "http://cloudagent-gateway.dep.svc.cluster.local"
    }
  ]
}
