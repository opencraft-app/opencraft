{
  "name": "agent-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cn": "vite --mode cn",
    "dev:global": "vite --mode global",
    "dev:local": "VITE_LOCAL_SDK=1 vite --mode cn",
    "dev:local:global": "VITE_LOCAL_SDK=1 vite --mode global",
    "dev:local-agentchat": "VITE_LOCAL_AGENTCHAT=1 vite --mode cn",
    "dev:local-all": "VITE_LOCAL_SDK=1 VITE_LOCAL_AGENTCHAT=1 vite --mode cn",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check",
    "assets:optimize": "node scripts/optimize-static-assets.mjs",
    "build": "tsc -b && vite build && node scripts/optimize-static-assets.mjs dist",
    "build:cn": "tsc -b && vite build --mode cn --outDir dist-cn && node scripts/optimize-static-assets.mjs dist-cn",
    "build:global": "tsc -b && vite build --mode global --outDir dist-global && node scripts/optimize-static-assets.mjs dist-global",
    "preview": "vite preview",
    "check": "tsc -b",
    "test": "vitest run",
    "deploy:cf": "node scripts/deploy-cloudflare-pages.mjs",
    "deploy:eo": "node scripts/deploy-edgeone-pages.mjs",
    "release:matrix": "node scripts/release-matrix.mjs",
    "archive:artifact": "node scripts/archive-release-artifact.mjs",
    "verify:artifact": "node scripts/verify-release-artifact.mjs",
    "build:release-artifacts": "node scripts/build-release-artifacts.mjs",
    "release:eo:artifact": "node scripts/release-edgeone-from-artifact.mjs",
    "release:cf:artifact": "node scripts/release-cloudflare-from-artifact.mjs"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "7.29.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@rollup/rollup-darwin-arm64": "^4.60.0",
    "@tencent/agentchat-lightvela-panel": "0.3.1",
    "@tencent/i18n": "^2.0.30",
    "@tencent/tcb-jssdk": "2.0.27",
    "@tencent/tea-sdk-lightclaw": "1.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "aegis-web-sdk": "^1.41.13",
    "bson": "^7.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.0.8",
    "html2canvas": "^1.4.1",
    "i18next": "^23.15.1",
    "lucide-react": "^0.554.0",
    "qrcode.react": "^3.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.0.2",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.9.4",
    "react-syntax-highlighter": "^15.5.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-x64": "^4.60.0",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^28.1.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "sharp"
    ],
    "overrides": {}
  }
}
