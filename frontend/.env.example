VITE_AUTH_API_BASE_URL=http://localhost:8081
# Set to mock for fully static deployments without a public auth backend.
# VITE_AUTH_API_BASE_URL=mock

# 静态资源 CDN 基址已硬编码在 src/lib/asset-url.ts 中，不再通过环境变量配置。

# Product analytics for the global site only. The project token is a public
# browser token from PostHog, but keep it environment-specific.
VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_PROJECT_TOKEN=phc_xxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_UI_HOST=https://us.posthog.com
# Next public-site builds use the matching NEXT_PUBLIC_* names.
NEXT_PUBLIC_POSTHOG_ENABLED=false
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# 大同（Datong）业务埋点。APPKEY 在 https://datong.woa.com 项目详情中获取；
# 全球站与国内站均可启用（cookie consent 通过后才会真正上报）。
VITE_DATONG_ENABLED=false
# VITE_DATONG_APPKEY=xxx
NEXT_PUBLIC_DATONG_ENABLED=false
NEXT_PUBLIC_DATONG_APPKEY=0WEB071LS3218EU7

# 本地 dev 模式上报开关：显式打开后，即便非生产构建也允许初始化大同 SDK，
# 便于本地联调埋点。生产构建忽略此开关。
VITE_DATONG_DEV_ENABLED=true
NEXT_PUBLIC_DATONG_DEV_ENABLED=true
