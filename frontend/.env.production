# 静态资源 CDN 基址已硬编码在 src/lib/asset-url.ts 中，不再通过环境变量配置。

# 连接器面板的 ai-server 地址（NEXT_PUBLIC_* 构建时内联进客户端产物；
# 缺失时 aiServerBase() 抛错，/api/connectors/* 请求不会发出）。
# 国内站（lightvela.com）与 ai-server 中国站同域体系；国际站构建亦加载
# 本文件，但连接器入口被 !isGlobal 拦截不消费该值（Gmail 二期再启用）。
NEXT_PUBLIC_AI_SERVER_BASE_URL=https://lightai.cloud.tencent.com

# 大同（Datong）业务埋点
VITE_DATONG_ENABLED=true
VITE_DATONG_APPKEY=0WEB071LS3218EU7
NEXT_PUBLIC_DATONG_ENABLED=true
NEXT_PUBLIC_DATONG_APPKEY=0WEB071LS3218EU7
