# 镜像 pin 文件。文件名必须以 -platform.env 结尾且在本目录内唯一：
# .ci/runtime/gitops/image_pin.py 从文件名推导 pin key（workers-platform.env -> WORKERS_IMAGE / WORKERS_DEPLOYED_AT）。
# WORKERS_IMAGE / WORKERS_DEPLOYED_AT 由 .ci/workers-website-deployer.yml 的 promote 流程覆盖写入。
WORKERS_IMAGE=lightclaw-shprod.tencentcloudcr.com/lightclaw/workers:REPLACE_BOOTSTRAP_TAG
WORKERS_DEPLOYED_AT=1970-01-01T00:00:00Z
WORKERS_NODE_POOL=general-shprod
