# ticket 服务 beijing-sandbox 环境注入值（非敏感）。
# 敏感项见 ticket-runtime-secrets.example.env，需经 ksops 加密后落到
# ../../../secrets/beijing-sandbox/ticket-runtime-secrets.sops.yaml
TICKET_IMAGE=lightclaw-bj8.tencentcloudcr.com/lightclaw/ticket:REPLACE_WITH_BUILT_TAG
TICKET_NODE_POOL=general-bj8
TICKET_DEPLOYED_AT=2026-07-06T00:00:00Z
# 反馈后台运营白名单：lightclaw 用户 ID，逗号分隔。
# 与 admin-gateway(service-gateway) access: authenticated 路由注入的 X-User-Id 一致。
TICKET_SUPPORT_AGENT_IDS=
