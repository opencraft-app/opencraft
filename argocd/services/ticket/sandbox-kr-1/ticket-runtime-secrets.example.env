# ticket 运行时敏感配置（示例，勿直接提交）。
# 用 sops 加密后落到 argocd/secrets/sandbox-kr-1/ticket-runtime-secrets.sops.yaml，
# 再由 ksops-secret-generator.yaml 在 ArgoCD 中解密为 Secret `ticket-runtime-secrets`。
#
# 必填项：
#   TICKET_ADMIN_TOKEN   运营侧共享密钥（/admin/tickets 仍使用），非空 fail-fast。
#   TICKET_MYSQL_DSN     ticket 主库 DSN，非空 fail-fast。
#                       示例: ticket:PASSWORD@tcp(mysql.lightvela-playground-sandbox-kr-1.svc.cluster.local:3306)/lightvela_ticket?parseTime=true
TICKET_ADMIN_TOKEN=
TICKET_MYSQL_DSN=
