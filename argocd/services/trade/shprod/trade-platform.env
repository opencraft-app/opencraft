# trade 上海正式（shprod）平台层真值
#
# 目标：让测试人员可在现网计费链路验证付费下单，同时不改变现网用户免费创建路径。
# free trial 仍由 ctl 的 bundle_free_trial_01 直走 CreateTrialPass，不进入 trade。

TRADE_IMAGE=lightclaw-shprod.tencentcloudcr.com/lightclaw/trade:REPLACE_TRADE_IMAGE_PLACEHOLDER
TRADE_NODE_POOL=general-shprod
TRADE_MYSQL_HOST=10.15.192.13
TRADE_MYSQL_PORT=3306

# jifei 现网 endpoint：经 lightvela-proxy prod 实例（tkexgz CLB 81.71.196.13）
# 透明转发到 jifei-prod / jifei-billing-apigw-prod。
JIFEI_CGW_GATEWAY_URL=http://81.71.196.13/v1/proxy/jifei-prod/interfaces/interface.php
JIFEI_BILLING_APIGW_URL=http://81.71.196.13/v1/proxy/jifei-billing-apigw-prod/resource-center/interface
TRADE_BILLING_ENDPOINT=
TRADE_BILLING_REGION=
TRADE_BILLING_REQUEST_TIMEOUT=
TRADE_BILLING_CLOUDLADDER_ENABLED=
TRADE_BILLING_CLOUDLADDER_GATEWAY_BASE_URL=
TRADE_BILLING_CLOUDLADDER_ROUTE_ID=
TRADE_BILLING_CLOUDLADDER_CALLER=
JIFEI_CGW_HOST_HEADER=
JIFEI_CGW_X_QCLOUD_USER_ID=

# 正式环境连接真实 lightclaw-auth shadow binding，不启用 mock。
TRADE_SHADOW_MOCK_ENABLED=
TRADE_SITE_KIND=cn
# 上海正式计费地域：出向 jifei envelope.resInfo.region 使用上海 4/400001。
LIGHTVELA_TRADE_REGION=ap-shanghai
# 询价专用影子账号兜底：仅 bundle 价格展示在用户未绑定 shadow binding 时使用；
# 付费下单仍强校验真实 shadow binding。
TRADE_INQUIRY_FALLBACK_UIN=330500000004
TRADE_INQUIRY_FALLBACK_APP_ID=1447552654

# 点石活动接入：当前按北京预发布实际配置启用启航 01 活动。
# 路径：trade -> lightvela-proxy（tkexgz CLB 81.71.196.13）-> dianshi-price /
# dianshi-order 两条 clgateway 路由。两个 env 必须成对配置。
DIANSHI_PRICE_BASE_URL=http://81.71.196.13/v1/proxy/dianshi-price/activity_price/activity/get_price
DIANSHI_ORDER_BASE_URL=http://81.71.196.13/v1/proxy/dianshi-order/activity_web/activity/do_goods

TRADE_DEPLOYED_AT=2026-07-07T00:00:00Z
