# trade 新加坡正式（sgprod）平台层真值 —— 国际站计费首次上线
#
# 上线策略（灰度期）：
#   本 overlay 首次把 trade 部署进新加坡现网，但前端 paidBillingEnabled 开关在国际站
#   默认关闭（frontend/src/contexts/runtime-config-context.tsx resolvePaidBillingEnabled：
#   isGlobal=true 时必须显式 opt-in），且 sgprod 的 ctl 尚未配置 [adapter.trade]，
#   因此 trade 上线后处于「零流量热备」状态，现网用户完全无感。
#
# 与 shprod（上海正式，国内站）的本质差异：
#   - TRADE_SITE_KIND=intl → jifei envelope.extraPara 写 site="2" language="en"
#     （见 trade/internal/jifeiclient/client.go makeExtraPara）
#   - 支付走 Billing CloudAPI CreatePayUrl（经 CloudLadder 出向），而非国内站的
#     jifei getMidasEarmarking
#   - 出向网关走 clgateway 国际站实例 tkexsg（lightvela-proxy-service-prod-intl），
#     而非国内站 tkexgz

TRADE_IMAGE=lightclaw-sgprod.tencentcloudcr.com/lightclaw/trade:REPLACE_TRADE_IMAGE_PLACEHOLDER
TRADE_NODE_POOL=general-sgprod
TRADE_MYSQL_HOST=10.15.192.12
TRADE_MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# jifei 出向（下单 GenerateDeals 等）：经 clgateway 国际站 prod 实例 tkexsg
# （CLB 43.153.236.65 = ingress vela-proxy-ingress-prod-intl）转发到 jifei 生产。
#
# 说明：jifei 计费系统全球统一，国际站不另设 jifei 路由，靠 envelope.extraPara 的
# site/language 与 resInfo.region 区分（TRADE_SITE_KIND=intl + LIGHTVELA_TRADE_REGION）。
# 因此这里复用 jifei-prod / jifei-billing-apigw-prod 两条生产路由。
# ---------------------------------------------------------------------------
JIFEI_CGW_GATEWAY_URL=http://43.153.236.65/v1/proxy/jifei-prod/interfaces/interface.php
JIFEI_BILLING_APIGW_URL=http://43.153.236.65/v1/proxy/jifei-billing-apigw-prod/resource-center/interface
# Host header 由 clgateway upstream.headers.Host 重写覆盖，trade 端不主动注入。
JIFEI_CGW_HOST_HEADER=
# 现网由部署侧出口 IP 鉴权，不带 x-qcloud-user-id（仅测试环境需要）。
JIFEI_CGW_X_QCLOUD_USER_ID=

# ---------------------------------------------------------------------------
# 国际站 Billing CloudAPI（CreatePayUrl）出向真值。
#
# ROUTE_ID 必须是 prod 路由：tcapi-billing-trade-intl-prod →
# http://billing.ap-singapore.tencentcloudapi.woa.com（新加坡内网生产 endpoint）。
# ⚠️ 不可沿用 trade 代码默认值 tcapi-billing-trade-intl-test，那条路由指向
# billing.test.tencentcloudapi.com，会把现网真实订单打到测试计费环境。
# ---------------------------------------------------------------------------
TRADE_BILLING_ENDPOINT=billing.ap-singapore.tencentcloudapi.woa.com
TRADE_BILLING_REGION=ap-singapore
TRADE_BILLING_CLOUDLADDER_GATEWAY_BASE_URL=http://43.153.236.65
TRADE_BILLING_CLOUDLADDER_ROUTE_ID=tcapi-billing-trade-intl-prod
# 支付完成 / 取消后的浏览器回跳地址（CreatePayUrl 的 ReturnUrl / CancelUrl 兜底）。
TRADE_BILLING_PAY_REDIRECT_URL=https://lightvela.ai/subscribe

# 正式环境连接真实 lightclaw-auth shadow binding，严禁启用 mock。
TRADE_SHADOW_MOCK_ENABLED=false
# 国际站身份：出向 jifei 带 site="2" / language="en" / currency=USD。
TRADE_SITE_KIND=intl
# 新加坡计费地域：出向 jifei envelope.resInfo.region 使用 9 / 900001。
LIGHTVELA_TRADE_REGION=ap-singapore

# 询价兜底影子账号：本次上线不启用，保持空值（两字段同进同退）。
# 灰度期无真实流量，不需要为未绑定用户展示价格；避免在现网引入固定兜底身份。
TRADE_INQUIRY_FALLBACK_UIN=
TRADE_INQUIRY_FALLBACK_APP_ID=

# ---------------------------------------------------------------------------
# 点石活动国际站接入。
#
# 出向路径：trade → clgateway 国际站 prod 实例 tkexsg（CLB 43.153.236.65）
#   → dianshi-price / dianshi-order 两条路由
#   → 新加坡生产 Polaris（见 tkexsg statefulsetplus.yaml 的
#     CLOUDLADDERGATEWAY_BACKEND_DIANSHI_*_BASE_URL：
#       price = opc-activity-price.production.sgpolaris:10006
#       order = opc-dianshi-activity.production.sgpolaris:80）
#   即国际站点石后端在 tkexsg 侧已按新加坡生产地址覆盖，trade 只需指到网关。
#
# 两个 env 必须同进同退：都非空 → main.go 装配 ActivityResolver + DianshiClient；
# 只配一边 → trade Load 期 panic。
#
# DIANSHI_PREVIEW 刻意不声明：
#   base trade-config 默认 "0"（trade/k8s/base/manifests.yaml），即正式（非预览）
#   模式。sandbox-kr-1 因联调需要显式覆盖为 "1"，现网不传 → 走 0。
#   注意 trade 对该字段做严格校验（只接受 "" / "0" / "1"，否则 Load 期报错），
#   因此这里保持不声明、不加 kustomization replacement，由 base 默认值兜底。
# ---------------------------------------------------------------------------
DIANSHI_PRICE_BASE_URL=http://43.153.236.65/v1/proxy/dianshi-price/activity_price/activity/get_price
DIANSHI_ORDER_BASE_URL=http://43.153.236.65/v1/proxy/dianshi-order/activity_web/activity/do_goods

TRADE_DEPLOYED_AT=2026-08-19T00:00:00Z
