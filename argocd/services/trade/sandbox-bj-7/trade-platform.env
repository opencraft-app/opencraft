# trade sandbox-bj-7 deploy-facing 真值（v1.7.30，2026-06-10 切换到 testing clgateway）
#
# 历史：v1.7.10 D9 落地 jifei env 注入到 trade pod，v1.7.13 B8 修 GatewayURL 用直连 IP，
# v1.7.30 切到独立 testing 实例 lightvela-proxy-testing（tkexgz 广州，CLB 1.12.212.56）。
# （北极星域名 clgateway.test.polaris 在 trade 集群 K8s CoreDNS 解析 NXDOMAIN —
# 与 v1.7.12 B7 修 clgateway 端 trade.itd.com DNS 问题完全对偶；trade 集群同样
# 无北极星 sidecar，必须用 IP 直连）。
#
# 字段语义（按 .tmp/integration-plan-2026-05-18.md §10 Q-INT-10 + Q-INT-12 拍板）：
#   - JIFEI_CGW_GATEWAY_URL：trade → clgateway 测试服务出向地址；
#     v1.7.10 用域名 http://clgateway.test.polaris:8095/...
#     v1.7.13 改为 IP http://81.71.196.13/...（指向 prod 实例 lightvela-proxy，与现网共用）
#     v1.7.30 改为 IP http://1.12.212.56/v1/proxy/jifei-test/interfaces/interface.php
#     （1.12.212.56:80 是新搭的 testing 实例 lightvela-proxy-testing 在 tkexgz 广州的
#     CLB 公网 IP，clgateway 北极星服务名 clgateway-testing；与 prod 物理隔离，2026-06-10
#     从跳板机实测：jifei-test 路由命中 X-Cloudladder-Upstream-Url=9.139.137.40 + Host=trade.itd.com，
#     jifei CGW 真实回 mock-304 + returnCode 170000001 "interface not exists"，链路验证通过）
#   - JIFEI_CGW_HOST_HEADER：v1.7.2 Q-INT-11=b 拍板由 clgateway upstream.headers.Host
#     重写覆盖，trade 端不主动注入；env 留空
#   - JIFEI_CGW_X_QCLOUD_USER_ID：v1.7.4 Q-INT-12 拍板的测试 uin（jifei 同事 2026-06-05
#     更换为 330500000003，原 700000164995 弃用）；
#     jifeiclient.do 在空字符串时跳过 header 注入
#
# 现网期切换约束（不在本配置内）：未来 trade 接入现网（shprod/sgprod）时，分别建
# argocd/services/trade/{shprod,sgprod}/trade-platform.env：
#   - URL 改 http://clgateway.prod.polaris:.../v1/proxy/jifei-prod/...（如现网集群有
#     北极星 sidecar）或对应 prod LB IP
#   - JIFEI_CGW_X_QCLOUD_USER_ID 改空字符串（部署侧出口 IP 鉴权）
TRADE_IMAGE=lightclaw-bj8.tencentcloudcr.com/lightclaw/trade@sha256:80d51ad412f5b0b5ce1d14fddda092ec385cc860beb8495d58bd94480a77ecdf
TRADE_NODE_POOL=general-bj82
TRADE_MYSQL_HOST=mysql.lightvela-playground-sandbox-bj-7.svc.cluster.local
TRADE_MYSQL_PORT=3306
JIFEI_CGW_GATEWAY_URL=http://1.12.212.56/v1/proxy/jifei-test/interfaces/interface.php
JIFEI_CGW_HOST_HEADER=
JIFEI_CGW_X_QCLOUD_USER_ID=330500000003
# Q-D-SIG-1~6 销毁链路 jifei 计费网关协议出向地址 (HMAC-SHA256 签名)
#   - 协议参考: .tmp/jifei_pdf_txt/计费网关-接入和签名算法.txt §签名算法 / §地址
#   - 真实端点: test.api-gateway.billing.tencentyun.com / 9.139.137.40
#   - sandbox-bj-7 路径: 经 clgateway 直连 IP (与 JIFEI_CGW_GATEWAY_URL 同 1.12.212.56 出口,
#     即 testing 实例 lightvela-proxy-testing 在 tkexgz 广州的 CLB; v1.7.30 从 81.71.196.13
#     prod 实例切换到 testing 实例),
#     *path 段为 /v1/proxy/jifei-billing-apigw-test/resource-center/interface;
#     clgateway upstream.headers.Host 重写 test.api-gateway.billing.tencentyun.com,
#     依赖 cloudladdergateway/config.example.yaml jifei-billing-apigw-test 路由 (已落地 v? );
#     2026-06-10 从跳板机实测：jifei-billing-apigw-test 路由命中
#     X-Cloudladder-Upstream-Url=9.139.137.40 + jifei 真实回 mock-564，链路验证通过
#   - 鉴权: 通过 envelope.interface.auth 4 字段 (appid/timestamp/nonce/signature) HMAC-SHA256;
#     密钥 JIFEI_BILLING_APP_ID / JIFEI_BILLING_APP_SECRET 走 SSM + sops 注入 (trade-runtime-secrets)
JIFEI_BILLING_APIGW_URL=http://1.12.212.56/v1/proxy/jifei-billing-apigw-test/resource-center/interface
# TRADE_SHADOW_MOCK_ENABLED (v1.7.28 BUG-02 修复):
#   sandbox-bj-7 没部署 shadow 服务, 但 trade 在 ctl b03226d6 Q30 alignment 后承担
#   "externalUserId → uin/appId 反查" 职责。启用 mock 后 trade 启动注入 mockShadowClient
#   (trade/cmd/trade/shadow_mock.go), 任意 externalUserId 都映射到固定 mock binding
#   {uin=700000164995, app_id=251202221} = jifei 测试 uin/appId, 跳过 shadow HTTP 调用。
#   现网切换 (shprod/sgprod) 必须设为 false / 空, 改用真实 shadow 服务。
TRADE_SHADOW_MOCK_ENABLED=true
TRADE_INQUIRY_FALLBACK_UIN=
TRADE_INQUIRY_FALLBACK_APP_ID=

# TRADE_SITE_KIND (v1.7.x 国际站接入 B2):
#   trade 部署站点语义字面量, 与 ctl/shadow/sandbox 同源同语义。
#   sandbox-bj-7 是国内站联调环境 → "cn":
#     - 出向 jifei envelope.resInfo 用广州 region (1/100001) + currency=CNY
#     - envelope.interface.extraPara 不写 site/language (omitempty 跳过)
#   设计稿: .tmp/trade-international-site-design.md v1.1 §3.1 A1/B1/B2/B3
#   注: 该字段被 common/kustomization.yaml replacements 强引用; 删除会导致
#       kustomize build 因找不到 source 字段而 fail。
TRADE_SITE_KIND=cn

# LIGHTVELA_TRADE_REGION (v1.7.x 北京 2 预发布接入):
#   trade 出向 jifei 协议的 region 字面量运行时 override，与 TRADE_SITE_KIND 解耦。
#   sandbox-bj-7 联调期不需要 override，留空字符串 → 走 SiteKind=cn 兜底默认 ap-guangzhou
#   (region=1 / regionId=100001)。
#   common/kustomization.yaml 已加 replacement 强引用，本字段必须显式存在。
LIGHTVELA_TRADE_REGION=

# === 点石活动接入（v1.7.x dianshi-activity-bundle；2026-06-24）===
# 设计稿：.tmp/dianshi-activity-bundle-design.md §5.7 / §5.8
# 仅启航 01 / 启航 AI 01 共享 activity_id=164273735574009 走点石；其它 bundle 仍走 jifei。
# 路径：trade → clgateway 测试出口（1.12.212.56）→ dianshi-price / dianshi-order
# 两条 clgateway 路由 → polaris-mesh DNS opc-activity-price / opc-dianshi-activity。
# 同进同退：两个 env 必须一起配；只配一边 trade Load 期 fail-fast。
# 注意：联调期点石后台对 sandbox 测试 uin（330500000003）若未开活动白名单，DoGoods 会
# 返业务错；本期 e2e 主要在 beijing-sandbox 跑通（用真实 uin 815836472）。
DIANSHI_PRICE_BASE_URL=http://1.12.212.56/v1/proxy/dianshi-price/activity_price/activity/get_price
DIANSHI_ORDER_BASE_URL=http://1.12.212.56/v1/proxy/dianshi-order/activity_web/activity/do_goods

TRADE_DEPLOYED_AT=2026-06-08T03:52:55Z
