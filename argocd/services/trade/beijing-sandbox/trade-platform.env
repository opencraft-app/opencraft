# trade 北京 2 预发布（beijing-sandbox）平台层真值
#
# 设计目标：完全按"现网形态"接入，与上海正式（shprod）链路等价；
#          与北京 7 测试环境（sandbox-bj-7）严格区分，去掉所有联调期测试特化。
#
# 与 sandbox-bj-7 的差异（v1.7.31 北京 2 预发布接入；2026-06-12 用户拍板）：
#   1. namespace=trade（独立服务 ns；与 payment user-auth、ctl ctl 同范式）
#   2. 不带 patch-playground-db.yaml：CTL_INTERNAL_BASE_URL / SHADOW_INTERNAL_BASE_URL
#      由 trade base ConfigMap 默认值 ctl-api.ctl.svc.cluster.local /
#      shadow.shadow.svc.cluster.local 直接生效（与现网 ns 拓扑一致）
#   3. 不带 trade-nodeport.yaml：北京 2 预发布暂不开 jifei 反向回调直连入口，
#      未来由 lightclaw-public ingress 反代 trade ClusterIP（与 shprod 同范式）
#   4. 不带 trade-migration-job.yaml：beijing-sandbox 沿用 payment 的"显式不接
#      migration job"纪律（README §A 改用人工 SOP 在 cynosdb 10.15.224.4 上跑
#      一次性 SQL 建库 + user；trade 启动后 GORM AutoMigrate 自动建表）
#   5. JIFEI_CGW_GATEWAY_URL / JIFEI_BILLING_APIGW_URL 指向**现网 jifei**：
#      - 经 lightvela-proxy prod 实例（tkexgz CLB 81.71.196.13）
#      - 新增 jifei-prod / jifei-billing-apigw-prod 两条 clgateway 路由（v1.7.31
#        cloudladdergateway/config.example.yaml backends/routes 段）
#      - jifei 真实 endpoint：trade.tencentyun.com / apigateway.billing.tencentyun.com
#        （PDF§国内现网环境，公网域名直连 + Host header 透传）
#   6. JIFEI_CGW_X_QCLOUD_USER_ID 留空：现网形态不再注入测试 uin header，
#      改由 envelope.ownerUin / loginUin 真实影子账号 uin 鉴权（v1.7.4 Q-INT-12
#      "现网由部署侧出口 IP 鉴权 / 走真实 shadow binding"约束）
#   7. TRADE_SHADOW_MOCK_ENABLED 留空：现网形态连真实 lightclaw-auth
#      shadow_bindings 表（不走 mockShadowClient 固定 700000164995/251202221）
#   8. LIGHTVELA_TRADE_REGION=ap-guangzhou：北京 2 预发布回退为广州 region
#      （2026-06-23），trade 出向 jifei envelope.resInfo.region 字段 override 为
#      广州 1/100001，规避北京一区 jifei 缺价问题；与 shprod 上海现网 region 同值。
#      未来需要切回北京 region 时改回 ap-beijing 即可（cn 身份 + 北京 region 解耦组合）。
#
# jifei 现网计费签名密钥（JIFEI_BILLING_APP_ID / JIFEI_BILLING_APP_SECRET）
# 与 sandbox-bj-7 测试环境共用同一组真值（用户 2026-06-12 明确）；落到
# trade-runtime-secrets Secret，envFrom 自动注入到 trade pod env，不在本文件出现。

# === 平台基础（与 payment beijing-sandbox 同款；TRADE_IMAGE 等 master CI 首次
#     promote MR 自动 bump 为真实 sha；与 base manifests.yaml REPLACE_TRADE_IMAGE
#     占位符语义一致）===
TRADE_IMAGE=lightclaw-bj8.tencentcloudcr.com/lightclaw/trade:REPLACE_TRADE_IMAGE_PLACEHOLDER
TRADE_NODE_POOL=general-bj8
TRADE_MYSQL_HOST=10.15.224.4
TRADE_MYSQL_PORT=3306

# === jifei 现网 endpoint（v1.7.31 北京 2 预发布接入）===
# 经 lightvela-proxy prod 实例（tkexgz CLB 81.71.196.13）→ jifei-prod /
# jifei-billing-apigw-prod 两条 clgateway 路由透明转发到 jifei 现网域名。
JIFEI_CGW_GATEWAY_URL=http://81.71.196.13/v1/proxy/jifei-prod/interfaces/interface.php
JIFEI_BILLING_APIGW_URL=http://81.71.196.13/v1/proxy/jifei-billing-apigw-prod/resource-center/interface
# Host header 由 clgateway upstream.headers.Host 重写覆盖（v1.7.2 Q-INT-11=b
# 拍板），trade 端不主动注入；env 留空。
JIFEI_CGW_HOST_HEADER=
# 现网由 envelope.ownerUin / loginUin 真实影子账号 uin 鉴权（用户 2026-06-12
# 明确"jifei 下单走真实影子账号"），trade 不再主动注入测试 uin header；
# jifeiclient.do 在空字符串时跳过 X-Qcloud-User-Id 注入。
JIFEI_CGW_X_QCLOUD_USER_ID=

# === 现网形态运行模式 ===
# 连真实 lightclaw-auth shadow_bindings 表（v1.7.28 BUG-02 mock 链路仅限联调
# 测试环境启用；现网必须留空 / "false" / "0"）。
TRADE_SHADOW_MOCK_ENABLED=
# 国内站身份（ctl/shadow/sandbox 的 LIGHTVELA_SITE_KIND 保持一致）。
TRADE_SITE_KIND=cn
# region 字段运行时 override：北京 2 预发布回退为广州 region（1/100001，2026-06-23），
# 规避北京一区 jifei 缺价。未来需切回北京 region 时改 ap-beijing；sgprod 国际站走 ap-singapore。
LIGHTVELA_TRADE_REGION=ap-guangzhou

# === 点石活动接入（v1.7.x dianshi-activity-bundle；2026-06-24）===
# 设计稿：.tmp/dianshi-activity-bundle-design.md §5.7 / §5.8
# 仅启航 01（act_id=1862147936410255）/ 启航 AI 01（act_id=1862105749386679）
# 共享 activity_id=164273735574009 走点石；其它 bundle 仍走 jifei。
# 路径：trade → lightvela-proxy（tkexgz CLB 81.71.196.13）→ dianshi-price /
# dianshi-order 两条 clgateway 路由 → polaris-mesh DNS opc-activity-price /
# opc-dianshi-activity（详见 cloudladdergateway/config.example.yaml）。
# 同进同退：两个 env 必须一起配；只配一边 trade Load 期 fail-fast。
DIANSHI_PRICE_BASE_URL=http://81.71.196.13/v1/proxy/dianshi-price/
DIANSHI_ORDER_BASE_URL=http://81.71.196.13/v1/proxy/dianshi-order/activity_web/activity/do_goods

TRADE_DEPLOYED_AT=2026-06-12T17:21:32Z
