FROM golang:1.24 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/ingressproxy-shard ./cmd/ingressproxy-shard

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/ingressproxy-shard /usr/local/bin/ingressproxy-shard
CMD ["ingressproxy-shard"]
