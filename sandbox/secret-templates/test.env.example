# Copy to /root/code/mono/.secret/sandbox/test.env and keep it out of git.
# This file is sourced by deploy-k8s.sh before building the Kustomize Secret input.
# Infra-provided MySQL/Redis passwords come from deploy/envs/<env>/platform.env.
# Keep only values that are not produced by infra.
# Default pools now require explicit per-pool security groups.

MYSQL_USER=root
TENCENT_SECRET_ID=replace-with-tencent-secret-id
TENCENT_SECRET_KEY=replace-with-tencent-secret-key
# Must match the token used by Auth and CTL for the internal Bot-scoped TAT path.
LIGHTCLAW_INTERNAL_SERVICE_TOKEN=
SANDBOX_POOL_BJ8_SECURITY_GROUPS=sg-replace-me
SANDBOX_POOL_C0_SECURITY_GROUPS=sg-replace-me
SANDBOX_POOL_C1_SECURITY_GROUPS=sg-replace-me
SANDBOX_POOL_C2_SECURITY_GROUPS=sg-replace-me
SANDBOX_POOL_C3_SECURITY_GROUPS=sg-replace-me
SANDBOX_POOL_C4_SECURITY_GROUPS=sg-replace-me
SANDBOX_POOL_C5_SECURITY_GROUPS=sg-replace-me
