# Copy to /root/code/mono/.secret/sandbox/local.env and keep it out of git.
# This single file is used by local docker compose, local e2e, and optional Tencent runs.
# Values are sourced by shell scripts, so wrap DSN-like values in quotes when they contain special characters.

SANDBOX_REDIS_PASSWORD=replace-with-local-redis-password
MYSQL_DSN="replace-with-local-mysql-dsn"
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-db-password
REDIS_PASSWORD=replace-with-local-redis-password
TENCENT_SECRET_ID=replace-with-tencent-secret-id
TENCENT_SECRET_KEY=replace-with-tencent-secret-key
TENCENT_REGION=ap-beijing
TENCENT_INSTANCE_TYPE=SA9.MEDIUM2
SANDBOX_TENCENT_LIVE=0
SANDBOX_TENCENT_LIVE_ZONE=ap-beijing-8
SANDBOX_TENCENT_LIVE_VPC_ID=vpc-replace-me
SANDBOX_TENCENT_LIVE_SUBNET_ID=subnet-replace-me
SANDBOX_TENCENT_LIVE_SECURITY_GROUPS=sg-replace-me
SANDBOX_TENCENT_LIVE_IMAGE_ID=img-replace-me
SANDBOX_TENCENT_LIVE_INSTANCE_TYPE=SA9.MEDIUM2
SANDBOX_E2E_MYSQL_DSN="replace-with-e2e-mysql-dsn"
SANDBOX_E2E_MYSQL_DATABASE=replace-with-e2e-mysql-database
SANDBOX_E2E_MYSQL_USER=replace-with-e2e-mysql-user
SANDBOX_E2E_MYSQL_PASSWORD=replace-with-e2e-mysql-password
SANDBOX_E2E_MYSQL_ROOT_PASSWORD=replace-with-e2e-mysql-root-password
