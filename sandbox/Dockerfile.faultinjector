# syntax=docker/dockerfile:1.7
FROM golang:1.22-bullseye AS builder
WORKDIR /app
ENV GOTOOLCHAIN=go1.24.0
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/faultinjector ./cmd/faultinjector

FROM alpine:3.19
RUN adduser -D -u 10003 app
WORKDIR /home/app
COPY --from=builder /out/faultinjector /usr/local/bin/faultinjector
USER app
ENV FAULTINJECTOR_ADDR=:8090
EXPOSE 8090
CMD ["faultinjector"]
