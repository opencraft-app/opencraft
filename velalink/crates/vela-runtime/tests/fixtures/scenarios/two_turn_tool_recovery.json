{
  "name": "two_turn_tool_recovery",
  "session_id": "ses_scenario_two_turn_tool_recovery",
  "steps": [
    {
      "idempotency_key": "idem-scenario-1",
      "content": "inspect the repo",
      "expect_status": "accepted",
      "backend_outputs": [
        {
          "event_type": "assistant.reasoning.delta",
          "payload": { "text": "I will inspect the workspace." },
          "raw": { "type": "scripted_reasoning_delta" }
        },
        {
          "event_type": "tool.started",
          "payload": { "tool_call_id": "tool_1", "name": "shell" },
          "raw": { "type": "scripted_tool_started" }
        },
        {
          "event_type": "tool.completed",
          "payload": { "tool_call_id": "tool_1", "exit_code": 0 },
          "raw": { "type": "scripted_tool_completed" }
        },
        {
          "event_type": "turn.completed",
          "payload": { "reason": "stop" },
          "raw": { "type": "scripted_agent_end" }
        }
      ]
    },
    {
      "idempotency_key": "idem-scenario-2",
      "content": "summarize findings",
      "expect_status": "accepted",
      "backend_outputs": [
        {
          "event_type": "assistant.message.delta",
          "payload": { "text": "The workspace is ready for scenario tests." },
          "raw": { "type": "scripted_message_delta" }
        },
        {
          "event_type": "turn.completed",
          "payload": { "reason": "stop" },
          "raw": { "type": "scripted_agent_end" }
        }
      ]
    }
  ],
  "expect_prompts": [
    "inspect the repo",
    "summarize findings"
  ],
  "expect_event_types": [
    "session.created",
    "user.message.accepted",
    "turn.started",
    "assistant.reasoning.delta",
    "tool.started",
    "tool.completed",
    "turn.completed",
    "user.message.accepted",
    "turn.started",
    "assistant.message.delta",
    "turn.completed"
  ]
}
