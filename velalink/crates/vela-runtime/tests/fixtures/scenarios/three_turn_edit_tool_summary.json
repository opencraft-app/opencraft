{
  "name": "three_turn_edit_tool_summary",
  "session_id": "ses_scenario_three_turn_edit_tool_summary",
  "steps": [
    {
      "idempotency_key": "idem-edit-1",
      "content": "draft a short changelog",
      "expect_status": "accepted",
      "backend_outputs": [
        {
          "event_type": "assistant.message.delta",
          "payload": { "text": "Drafted a short changelog." },
          "raw": { "provider": "scripted", "type": "message_delta", "turn": 1 }
        },
        {
          "event_type": "turn.completed",
          "payload": { "reason": "stop" },
          "raw": { "provider": "scripted", "type": "agent_end", "turn": 1 }
        }
      ]
    },
    {
      "idempotency_key": "idem-edit-2",
      "content": "revise it with a testing section",
      "expect_status": "accepted",
      "backend_outputs": [
        {
          "event_type": "assistant.reasoning.delta",
          "payload": { "text": "I need to inspect existing tests before revising." },
          "raw": { "provider": "scripted", "type": "thinking_delta", "turn": 2 }
        },
        {
          "event_type": "tool.started",
          "payload": { "tool_call_id": "tool_edit_1", "name": "shell", "input": { "cmd": "rg --files tests" } },
          "raw": { "provider": "scripted", "type": "tool_execution_start", "turn": 2 }
        },
        {
          "event_type": "tool.output.delta",
          "payload": { "tool_call_id": "tool_edit_1", "text": "tests/send_user_message.rs\n" },
          "raw": { "provider": "scripted", "type": "tool_execution_output", "turn": 2 }
        },
        {
          "event_type": "tool.completed",
          "payload": { "tool_call_id": "tool_edit_1", "exit_code": 0 },
          "raw": { "provider": "scripted", "type": "tool_execution_end", "turn": 2 }
        },
        {
          "event_type": "assistant.message.delta",
          "payload": { "text": "Added a testing section." },
          "raw": { "provider": "scripted", "type": "message_delta", "turn": 2 }
        },
        {
          "event_type": "turn.completed",
          "payload": { "reason": "stop" },
          "raw": { "provider": "scripted", "type": "agent_end", "turn": 2 }
        }
      ]
    },
    {
      "idempotency_key": "idem-edit-3",
      "content": "summarize the final diff",
      "expect_status": "accepted",
      "backend_outputs": [
        {
          "event_type": "assistant.message.delta",
          "payload": { "text": "Final diff: changelog plus tests section." },
          "raw": { "provider": "scripted", "type": "message_delta", "turn": 3 }
        },
        {
          "event_type": "turn.completed",
          "payload": { "reason": "stop" },
          "raw": { "provider": "scripted", "type": "agent_end", "turn": 3 }
        }
      ]
    }
  ],
  "expect_prompts": [
    "draft a short changelog",
    "revise it with a testing section",
    "summarize the final diff"
  ],
  "expect_event_types": [
    "session.created",
    "user.message.accepted",
    "turn.started",
    "assistant.message.delta",
    "turn.completed",
    "user.message.accepted",
    "turn.started",
    "assistant.reasoning.delta",
    "tool.started",
    "tool.output.delta",
    "tool.completed",
    "assistant.message.delta",
    "turn.completed",
    "user.message.accepted",
    "turn.started",
    "assistant.message.delta",
    "turn.completed"
  ]
}
