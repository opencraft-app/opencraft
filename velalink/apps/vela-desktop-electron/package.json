{
  "private": true,
  "name": "@vela/desktop-electron",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "build": "vite build --config vite.electron.config.ts && esbuild electron/preload.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outfile=dist-electron/preload.cjs && vite build --config vite.renderer.config.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "build:electron": "vite build --config vite.electron.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "latest",
    "react-dom": "latest",
    "vite": "^5.4.19"
  },
  "devDependencies": {
    "electron": "42.4.1",
    "electron-builder": "^26.15.3"
  }
}
