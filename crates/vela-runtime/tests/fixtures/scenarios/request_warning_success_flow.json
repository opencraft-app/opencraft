{
  "name": "request_warning_success_flow",
  "session_id": "ses_scenario_request_warning_success_flow",
  "steps": [
    {
      "idempotency_key": "idem-request-1",
      "content": "try the risky operation and ask if blocked",
      "expect_status": "accepted",
      "backend_outputs": [
        {
          "event_type": "assistant.reasoning.delta",
          "payload": { "text": "This operation needs explicit confirmation." },
          "raw": { "provider": "scripted", "type": "thinking_delta" }
        },
        {
          "event_type": "request.opened",
          "payload": { "request_id": "req_permission_1", "kind": "permission", "title": "Allow shell command" },
          "raw": { "provider": "scripted", "type": "permission_request" }
        },
        {
          "event_type": "warning.raised",
          "payload": { "message": "Provider emitted an unknown side event." },
          "raw": { "provider": "scripted", "type": "unknown_side_event" }
        },
        {
          "event_type": "assistant.message.delta",
          "payload": { "text": "I need permission before continuing." },
          "raw": { "provider": "scripted", "type": "message_delta" }
        },
        {
          "event_type": "turn.completed",
          "payload": { "reason": "needs_permission" },
          "raw": { "provider": "scripted", "type": "agent_end" }
        }
      ]
    },
    {
      "idempotency_key": "idem-request-2",
      "content": "permission granted; continue",
      "expect_status": "accepted",
      "backend_outputs": [
        {
          "event_type": "request.resolved",
          "payload": { "request_id": "req_permission_1", "resolution": "approved" },
          "raw": { "provider": "scripted", "type": "permission_resolved" }
        },
        {
          "event_type": "tool.started",
          "payload": { "tool_call_id": "tool_request_1", "name": "shell" },
          "raw": { "provider": "scripted", "type": "tool_execution_start" }
        },
        {
          "event_type": "tool.completed",
          "payload": { "tool_call_id": "tool_request_1", "exit_code": 0 },
          "raw": { "provider": "scripted", "type": "tool_execution_end" }
        },
        {
          "event_type": "assistant.message.delta",
          "payload": { "text": "The operation completed after approval." },
          "raw": { "provider": "scripted", "type": "message_delta" }
        },
        {
          "event_type": "turn.completed",
          "payload": { "reason": "stop" },
          "raw": { "provider": "scripted", "type": "agent_end" }
        }
      ]
    }
  ],
  "expect_prompts": [
    "try the risky operation and ask if blocked",
    "permission granted; continue"
  ],
  "expect_event_types": [
    "session.created",
    "user.message.accepted",
    "turn.started",
    "assistant.reasoning.delta",
    "request.opened",
    "warning.raised",
    "assistant.message.delta",
    "turn.completed",
    "user.message.accepted",
    "turn.started",
    "request.resolved",
    "tool.started",
    "tool.completed",
    "assistant.message.delta",
    "turn.completed"
  ]
}
