{
  "expo": {
    "name": "OpenCraft",
    "slug": "opencraft-workbench",
    "version": "0.1.0",
    "scheme": "opencraft",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.vela.workbench"
    },
    "android": {
      "package": "dev.vela.workbench",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      ["expo-image-picker", {
        "photosPermission": "Allow LightVela to choose a profile photo.",
        "cameraPermission": false,
        "microphonePermission": false
      }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
