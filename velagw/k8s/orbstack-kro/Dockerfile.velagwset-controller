FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -o /out/velagwset-controller ./cmd/velagwset-controller

FROM alpine:3.20

COPY --from=builder /out/velagwset-controller /usr/local/bin/velagwset-controller

ENTRYPOINT ["/usr/local/bin/velagwset-controller"]
