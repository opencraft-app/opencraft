apiVersion: v1
kind: ServiceAccount
metadata:
  name: llmgateway-upgrade-soak
  namespace: __NAMESPACE__
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: llmgateway-upgrade-soak
  namespace: __NAMESPACE__
rules:
  - apiGroups: ["batch"]
    resources: ["cronjobs", "jobs"]
    verbs: ["get", "list", "create", "patch", "delete"]
  - apiGroups: ["apps"]
    resources: ["deployments"]
    verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: llmgateway-upgrade-soak
  namespace: __NAMESPACE__
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: llmgateway-upgrade-soak
subjects:
  - kind: ServiceAccount
    name: llmgateway-upgrade-soak
    namespace: __NAMESPACE__
---
apiVersion: v1
kind: Service
metadata:
  name: llmgateway-upgrade-soak-pacer
  namespace: __NAMESPACE__
spec:
  selector:
    app.kubernetes.io/name: llmgateway-upgrade-soak
  ports:
    - name: http
      port: 18090
      targetPort: 18090
---
apiVersion: batch/v1
kind: Job
metadata:
  name: llmgateway-upgrade-soak
  namespace: __NAMESPACE__
  labels:
    app.kubernetes.io/name: llmgateway-upgrade-soak
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 14400
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        app.kubernetes.io/name: llmgateway-upgrade-soak
    spec:
      serviceAccountName: llmgateway-upgrade-soak
      imagePullSecrets:
        - name: tcr-pull-secret
      restartPolicy: Never
      terminationGracePeriodSeconds: 30
      containers:
        - name: coordinator
          image: __RUNNER_IMAGE__
          imagePullPolicy: __IMAGE_PULL_POLICY__
          command: ["/usr/local/bin/llmgateway-set-upgrade-soak"]
          resources:
            requests:
              cpu: 250m
              memory: 256Mi
            limits:
              cpu: "2"
              memory: 1Gi
          env:
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: LLMGATEWAY_CONTROL_URL
              value: "__CONTROL_URL__"
            - name: LLMGATEWAY_TRAFFIC_URL
              value: "__TRAFFIC_URL__"
            - name: LLMGATEWAY_SOAK_MOCK_URL
              value: "__MOCK_URL__"
            - name: LLMGATEWAY_SOAK_PACER_URL
              value: "http://llmgateway-upgrade-soak-pacer:18090"
            - name: LLMGATEWAY_SOAK_FLEET
              value: "__FLEET__"
            - name: LLMGATEWAY_SOAK_SOURCE
              value: "__SOURCE__"
            - name: LLMGATEWAY_SOAK_TARGET_SET
              value: "__TARGET_SET__"
            - name: LLMGATEWAY_SOAK_TARGET_IMAGE
              value: "__TARGET_IMAGE__"
            - name: LLMGATEWAY_SOAK_GENERATIONS
              value: "__GENERATIONS__"
            - name: LLMGATEWAY_SOAK_USERS
              value: "__USERS__"
            - name: LLMGATEWAY_SOAK_SSE_USERS
              value: "__SSE_USERS__"
            - name: LLMGATEWAY_SOAK_USER_CONCURRENCY
              value: "__USER_CONCURRENCY__"
            - name: LLMGATEWAY_SOAK_NORMAL_INTERVAL
              value: "__NORMAL_INTERVAL__"
            - name: LLMGATEWAY_SOAK_SSE_DURATION
              value: "__SSE_DURATION__"
            - name: LLMGATEWAY_SOAK_MIN_SSE_DURATION
              value: "__MIN_SSE_DURATION__"
            - name: LLMGATEWAY_SOAK_WARMUP
              value: "__WARMUP__"
            - name: LLMGATEWAY_SOAK_DRAIN_TIMEOUT
              value: "__DRAIN_TIMEOUT__"
            - name: LLMGATEWAY_SOAK_ROLLBACK_WINDOW
              value: "__ROLLBACK_WINDOW__"
            - name: LLMGATEWAY_SOAK_MANAGER_TIMEOUT
              value: "__MANAGER_TIMEOUT__"
            - name: LLMGATEWAY_SOAK_MANAGER_CRONJOB
              value: "__MANAGER_CRONJOB__"
            - name: LLMGATEWAY_SOAK_MODEL
              value: "__MODEL__"
            - name: LLMGATEWAY_SOAK_UPSTREAM_MODEL
              value: "__UPSTREAM_MODEL__"
            - name: LLMGATEWAY_ADMIN_TOKEN
              valueFrom:
                secretKeyRef:
                  name: __ADMIN_SECRET__
                  key: __ADMIN_SECRET_KEY__
            - name: LLMGATEWAY_INTERNAL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: __INTERNAL_SECRET__
                  key: __INTERNAL_SECRET_KEY__
