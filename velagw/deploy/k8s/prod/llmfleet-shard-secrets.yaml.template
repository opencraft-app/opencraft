apiVersion: v1
kind: Secret
metadata:
  name: llmfleet-shard-a
  namespace: llmgateway
type: Opaque
stringData:
  mysqlAdminUser: root
  mysqlAdminPassword: ${SHARD_A_MYSQL_ROOT_PASSWORD}
  mysqlAppUser: newapi_app
  mysqlAppPassword: ${NEWAPI_APP_MYSQL_PASSWORD}
  redisPasswordEncoded: ${SHARD_A_REDIS_PASSWORD_ENCODED}
