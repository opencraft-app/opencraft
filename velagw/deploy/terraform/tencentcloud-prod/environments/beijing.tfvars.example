region       = "ap-beijing"
region_alias = "bj"
project      = "llmgateway"
environment  = "prod"

availability_zones = ["ap-beijing-6", "ap-beijing-7"]

vpc_cidr            = "10.64.0.0/16"
public_subnet_cidrs = ["10.64.0.0/24", "10.64.1.0/24"]
app_subnet_cidrs    = ["10.64.10.0/23", "10.64.12.0/23"]
data_subnet_cidrs   = ["10.64.20.0/24", "10.64.21.0/24"]

# Replace with office/VPN egress CIDRs.
admin_cidrs = ["203.0.113.10/32"]

traffic_backend_cidrs = ["0.0.0.0/0"]
traffic_backend_port  = "18080"

dns_domain            = "lightvela.com"
control_dns_subdomain = "llmgw-control"
traffic_dns_subdomain = "llmgw-inner"
edge_dns_enabled      = true
control_clb_domain    = "lb-m2z2hu01-gc1pzodr6i4eyjq5.clb.bj-tencentclb.com."
traffic_clb_domain    = "lb-kmvdis9v-zjksm2601iqxwrvl.clb.bj-tencentclb.com."
control_cert_id       = "XCYa3P4e"
traffic_cert_id       = "XCYa3P4e"

tcr_instance_id   = "tcr-g7ax6o7q"
tcr_public_domain = "lightclaw-bj82.tencentcloudcr.com"
tcr_namespace     = "llmgateway"
tcr_repository    = "llmgateway"

tke_cluster_version = "1.30.0"
tke_cluster_level   = "L20"
tke_service_cidr    = "172.21.0.0/22"
tke_cluster_description = "LLMGateway production TKE cluster in Beijing."

# Never commit real values. Put them in a local *.tfvars file or TF_VAR_*.
mysql_root_password = "Replace-With-A-Strong-Password"
redis_password      = "Replace16!"

control_mysql = {
  mem_size    = 4000
  volume_size = 100
  cpu         = 2
}

control_redis = {
  type_id              = 18
  mem_size             = 1024
  redis_shard_num      = 3
  redis_replicas_num   = 3
  replica_zone_indexes = [0, 1, 1]
}

shards = {
  shard-a = {
    zone_index       = 0
    mysql_mem_size   = 4000
    mysql_volume_size = 100
    mysql_cpu        = 2
    redis_type_id    = 17
    redis_mem_size   = 1024
    redis_shard_num  = 1
    redis_replicas   = 1
    max_sets         = 4
  }
  shard-b = {
    zone_index       = 1
    mysql_mem_size   = 4000
    mysql_volume_size = 100
    mysql_cpu        = 2
    redis_type_id    = 17
    redis_mem_size   = 1024
    redis_shard_num  = 1
    redis_replicas   = 1
    max_sets         = 4
  }
}
