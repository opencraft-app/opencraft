{
  "_comment": "项目级 MCP 配置示例。请复制本文件为 .codebuddy/mcp.json，并把下方占位符替换为你自己的 Token；mcp.json 已在 .gitignore 中，不会被提交。",
  "_setup": [
    "1. cp .codebuddy/mcp.json.example .codebuddy/mcp.json",
    "2. 编辑 .codebuddy/mcp.json，替换 <your-tapd-access-token> 与 <your-gongfeng-private-token>",
    "3. TAPD Token 获取: https://tapd.woa.com/platform/myhome?not_direct=1&from=mcp#tab=tab-mytoken",
    "4. Gongfeng Token 获取: https://git.woa.com/profile/account"
  ],
  "mcpServers": {
    "tapd_mcp_http": {
      "url": "https://mcp-oa.tapd.woa.com/mcp/",
      "timeout": 20000,
      "headers": {
        "X-Tapd-Access-Token": "<your-tapd-access-token>"
      },
      "transportType": "streamable-http"
    },
    "gongfeng_mcp_http": {
      "url": "https://mcp.git.woa.com/mcp/",
      "timeout": 20000,
      "headers": {
        "PRIVATE-TOKEN": "<your-gongfeng-private-token>"
      },
      "transportType": "streamable-http"
    }
  }
}
