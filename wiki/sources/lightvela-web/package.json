{
  "name": "lightvela-report",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import:deck": "python3 scripts/build_infra.py && python3 scripts/import_deck.py",
    "build:infra": "python3 scripts/build_infra.py",
    "build:pages": "node scripts/build_pages.mjs",
    "test:auth": "node --test cloudflare/auth.test.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.8.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
