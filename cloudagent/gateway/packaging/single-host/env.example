# CloudAgent single-host ACP gateway config.
#
# Required:
# - TOKENHUB_API_KEY: model provider key used by agent-rust.
# - GATEWAY_AGENT_SIDECAR_URL: downloadable linux/amd64 agent sidecar URL.
# - SMH_LIBRARY_ID / SMH_ACCESS_DOMAIN / SMH_LIBRARY_SECRET: Wisp persistence backend.

TOKENHUB_API_KEY=
TOKENHUB_MODEL=minimax-m2.7

GATEWAY_AGENT_SIDECAR_URL=
GATEWAY_AGENT_SIDECAR_SHA256=

SMH_LIBRARY_ID=
SMH_ACCESS_DOMAIN=
SMH_LIBRARY_SECRET=
SMH_SPACE_ID=

GATEWAY_ADDR=127.0.0.1:18094
GATEWAY_DATA_DIR=/var/lib/cloudagent-gateway
GATEWAY_LOCAL_RUNTIME_ROOT=/var/lib/cloudagent-runtime
GATEWAY_WISP_ROOT_UPPER_SIZE=5G
GATEWAY_WISP_JFS_PREFIX=workspace

# Optional if sandbox-host is published separately.
GATEWAY_SANDBOX_HOST_URL=
GATEWAY_SANDBOX_HOST_SHA256=
GATEWAY_SANDBOX_HOST_TRANSPORT=cli
GATEWAY_SANDBOX_HOST_ALLOW_CLI_FALLBACK=1
