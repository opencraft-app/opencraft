# This file is sourced by user/auth/scripts/deploy-k8s.sh before building the Kustomize Secret input.
# Copy to .secret/user-auth/test.env and fill real values.

# Required
LIGHTCLAW_ADMIN_TOKEN=replace-me
LIGHTCLAW_DEVICE_BIND_TOKEN_SECRET=replace-with-random-32-byte-secret
LIGHTCLAW_DEVICE_BIND_TOKEN_TTL_SECONDS=600

# Optional overrides. If omitted, deploy script falls back to platform.env values where possible.
LIGHTCLAW_AUTH_DB_PASSWORD=
USER_AUTH_MYSQL_ROOT_PASSWORD=
LIGHTCLAW_DEV_SMS_CODE=
LIGHTCLAW_PHONE_AUTH_ENABLED=false
LIGHTCLAW_SMS_SECRET_ID=
LIGHTCLAW_SMS_SECRET_KEY=
LIGHTCLAW_SMS_REGION=ap-guangzhou
LIGHTCLAW_SMS_ENDPOINT=sms.internal.tencentcloudapi.com
LIGHTCLAW_SMS_SDK_APP_ID=1401097405
LIGHTCLAW_SMS_SIGN_NAME=腾讯云
LIGHTCLAW_SMS_TEMPLATE_ID=2683912

# QQ OAuth. Leave blank to disable QQ OAuth.
LIGHTCLAW_QQ_APP_ID=1903611152
LIGHTCLAW_QQ_APP_KEY=
LIGHTCLAW_QQ_REDIRECT_URI=

# Google OAuth. Leave blank to disable Google OAuth.
LIGHTCLAW_GOOGLE_CLIENT_ID=
LIGHTCLAW_GOOGLE_CLIENT_SECRET=
LIGHTCLAW_GOOGLE_REDIRECT_URI=

# GitHub OAuth. Leave blank to disable GitHub OAuth.
LIGHTCLAW_GITHUB_CLIENT_ID=
LIGHTCLAW_GITHUB_CLIENT_SECRET=
LIGHTCLAW_GITHUB_REDIRECT_URI=

# WeChat website OAuth. Leave blank to disable WeChat OAuth.
LIGHTCLAW_WECHAT_APP_ID=
LIGHTCLAW_WECHAT_APP_SECRET=
LIGHTCLAW_WECHAT_REDIRECT_URI=
LIGHTVELA_WECHAT_WEBSITE_APP_ID=
LIGHTVELA_WECHAT_WEBSITE_APP_SECRET=
LIGHTVELA_WECHAT_WEBSITE_REDIRECT_URI=
LIGHTVELA_WECHAT_OFFICIAL_ACCOUNT_APP_ID=
LIGHTVELA_WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
LIGHTVELA_WECHAT_OFFICIAL_ACCOUNT_REDIRECT_URI=

# COS avatar store. Leave blank to disable avatar uploads.
LIGHTCLAW_COS_BUCKET_URL=
LIGHTCLAW_COS_SECRET_ID=
LIGHTCLAW_COS_SECRET_KEY=

# Tencent FaceID real-name verification. Leave blank to disable real-name verification.
TENCENT_REALNAME_SECRET_ID=
TENCENT_REALNAME_SECRET_KEY=
TENCENT_REALNAME_ENDPOINT=faceid.tencentcloudapi.com
TENCENT_REALNAME_FACEID_RULE_ID=
TENCENT_REALNAME_ACCOUNT_ID=
TENCENT_REALNAME_FACEID_REDIRECT_URL=
REALNAME_ENCRYPTION_KEY=

# Tencent TAT managed instance registration. Leave blank to disable TAT device binding.
TENCENT_TAT_SECRET_ID=
TENCENT_TAT_SECRET_KEY=
TENCENT_TAT_REGION=ap-guangzhou
TENCENT_TAT_ENDPOINT=tat.tencentcloudapi.com
TENCENT_TAT_REGISTER_EFFECTIVE_HOURS=24
TENCENT_TAT_INSTANCE_NAME_PREFIX=lightvela-mac
TENCENT_TAT_REGISTER_IP_RANGE=

# Content safety audit for profile nickname/avatar changes. The API submits
# synchronously when CONTENT_AUDIT_ENDPOINT is available; the worker keeps
# processing legacy or fallback queued tasks.
CONTENT_AUDIT_ENABLED=false
CONTENT_AUDIT_ENDPOINT=
CONTENT_AUDIT_PROXY_TOKEN=
CONTENT_AUDIT_PRODUCT_ID=
CONTENT_AUDIT_USER_SID=
CONTENT_AUDIT_TIMEOUT_MINUTES=15
CONTENT_AUDIT_WORKER_INTERVAL_SECONDS=30
CONTENT_AUDIT_WORKER_BATCH_SIZE=20

# Optional explicit overrides
USER_AUTH_MYSQL_HOST=
USER_AUTH_MYSQL_PORT=
USER_AUTH_PUBLIC_BASE_URL=
USER_AUTH_FRONTEND_BASE_URL=
USER_AUTH_NODE_POOL=
