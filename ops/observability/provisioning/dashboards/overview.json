{
  "uid": "opencraft-overview",
  "title": "OpenCraft 平台全景可观测性看板",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "opencraft",
    "observe-v1.1.3",
    "可观测性"
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "用户交互与耗时体验",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "前台交互耗时（P95 估算，5分钟窗口）",
      "description": "operations.latency; histogram_approximation; observe-v1.1.3。前台关键交互操作（如打开会话、页面导航等）端到端 P95 耗时估算值。无样本不代表服务健康；直方图分位数由 5 分钟滑动窗口桶估算。",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opencraft-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation, cache, engine) (rate(opencraft_interactive_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} [{{cache}}] ({{engine}})",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [
            {
              "type": "value",
              "options": {
                "navigation": {
                  "text": "页面导航 (navigation)"
                },
                "thread_open": {
                  "text": "打开会话 (thread_open)"
                },
                "catalog_first": {
                  "text": "模型首选 (catalog_first)"
                },
                "catalog_complete": {
                  "text": "完整目录加载 (catalog_complete)"
                },
                "configuration_confirmed": {
                  "text": "配置确认 (configuration_confirmed)"
                },
                "submit_ready": {
                  "text": "输入就绪 (submit_ready)"
                },
                "preference_save": {
                  "text": "偏好保存 (preference_save)"
                },
                "recovery": {
                  "text": "状态恢复 (recovery)"
                },
                "other": {
                  "text": "其他操作 (other)"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "交互操作结果分布（按来源，5分钟窗口）",
      "description": "operations.outcomes; histogram_approximation; observe-v1.1.3。前台交互操作的成功/失败/超时状态统计（按交互来源 origin 划分）。无样本不代表服务健康；增量由 5 分钟滑动窗口估算。",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "opencraft-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome, origin) (increase(opencraft_observed_operations_total[5m]))",
          "legendFormat": "{{operation}} - {{outcome}} ({{origin}})",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "started": {
                  "text": "已启动 (started)",
                  "color": "blue"
                },
                "progress": {
                  "text": "进行中 (progress)",
                  "color": "purple"
                },
                "ok": {
                  "text": "成功 (ok)",
                  "color": "green"
                },
                "failed": {
                  "text": "失败 (failed)",
                  "color": "red"
                },
                "timeout": {
                  "text": "超时 (timeout)",
                  "color": "orange"
                },
                "aborted": {
                  "text": "已中止 (aborted)",
                  "color": "dark-red"
                },
                "unfinished": {
                  "text": "未完成 (unfinished)",
                  "color": "yellow"
                },
                "unknown": {
                  "text": "未知 (unknown)",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "已校验交互真人用户数（24小时去重）",
      "description": "usage.activity24h; exact_domain_aggregation; observe-v1.1.3。过去 24 小时内经过认证并产生交互行为的真人独立用户数。领域精确指标，按评估时间点实时去重。",
