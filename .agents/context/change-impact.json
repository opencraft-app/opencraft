      "exclude_paths": ["**/*_test.go", "**/testdata/**", "**/__tests__/**", "**/*.test.*", "**/*.spec.*", "**/tests/**", "**/*.md", "**/i18n/**", "**/pages/marketing/**", "**/public/assets/**", "**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.svg", "**/*.gif", "**/*.webp", "**/*.ico"],
