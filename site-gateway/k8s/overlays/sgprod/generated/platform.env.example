# Copy to platform.env for local source-overlay rendering. Do not commit real values.
SITE_GATEWAY_IMAGE=lightclaw-sgprod.tencentcloudcr.com/lightclaw/site-gateway:REPLACE_TAG
SITE_GATEWAY_DEPLOYED_AT=1970-01-01T00:00:00Z
SITE_GATEWAY_ROOT_DOMAINS=REPLACE_SITE_ROOT_DOMAIN
SITE_GATEWAY_WILDCARD_HOST=REPLACE_SITE_WILDCARD_HOST
SITE_GATEWAY_TLS_SECRET_NAME=site-gateway-wildcard-tls
SITE_GATEWAY_COS_BUCKET=REPLACE_WEBSITE_COS_BUCKET
SITE_GATEWAY_COS_REGION=ap-singapore
SITE_GATEWAY_CTL_BASE_URL=http://ctl-api.ctl.svc.cluster.local
SITE_GATEWAY_AUTH_MODE=public
SITE_GATEWAY_AUTH_ENDPOINTS_ENABLED=true
SITE_GATEWAY_AUTH_FIXED_HOST=sites-auth.lightvela.site
SITE_GATEWAY_AUTH_OIDC_ISSUER=https://api.lightvela.ai
SITE_GATEWAY_AUTH_OIDC_AUTHORIZE_URL=https://api.lightvela.ai/oauth2/authorize
SITE_GATEWAY_AUTH_OIDC_TOKEN_URL=https://api.lightvela.ai/oauth2/token
SITE_GATEWAY_AUTH_OIDC_JWKS_URL=https://api.lightvela.ai/.well-known/jwks.json
SITE_GATEWAY_AUTH_OIDC_CLIENT_ID=site-gateway
SITE_GATEWAY_AUTH_AEAD_ACTIVE_KEY_ID=site-gateway-sg-20260824-1
SITE_GATEWAY_AUTH_SESSION_TTL=5m
SITE_GATEWAY_DSH_DOMAINS=dsh.lightvela.site
SITE_GATEWAY_DSH_FEDERATION_AUTHORIZE_URL=https://lightvela.ai/auth/federation/authorize
SITE_GATEWAY_DSH_FEDERATION_BASE_URL=http://lightclaw-auth.user-auth.svc.cluster.local
SITE_GATEWAY_DSH_FEDERATION_CLIENT_ID=personal-site
SITE_GATEWAY_DSH_FEDERATION_KEY_ID=federation-client-sg-20260824-1
