# Copy to platform.env for local source-overlay rendering. Do not commit real values.
SITE_GATEWAY_IMAGE=lightclaw-sgprod.tencentcloudcr.com/lightclaw/site-gateway:REPLACE_TAG
SITE_GATEWAY_DEPLOYED_AT=1970-01-01T00:00:00Z
SITE_GATEWAY_ROOT_DOMAINS=REPLACE_SITE_ROOT_DOMAIN
SITE_GATEWAY_WILDCARD_HOST=REPLACE_SITE_WILDCARD_HOST
SITE_GATEWAY_TLS_SECRET_NAME=site-gateway-wildcard-tls
SITE_GATEWAY_COS_BUCKET=REPLACE_WEBSITE_COS_BUCKET
SITE_GATEWAY_COS_REGION=ap-singapore
SITE_GATEWAY_CTL_BASE_URL=http://ctl-api.ctl.svc.cluster.local
SITE_GATEWAY_AUTH_MODE=public
SITE_GATEWAY_AUTH_ISSUER=
SITE_GATEWAY_AUTH_AUDIENCE=
SITE_GATEWAY_AUTH_START_URL=
SITE_GATEWAY_AUTH_PUBLIC_KEYS=
SITE_GATEWAY_AUTH_SESSION_TTL=5m
