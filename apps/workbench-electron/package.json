{
  "name": "@opencraft/workbench-electron",
  "private": true,
  "version": "0.1.0",
  "description": "OpenCraft desktop workbench",
  "author": {
    "name": "OpenCraft",
    "email": "support@lightvela.ai"
  },
  "homepage": "https://lightvela.ai",
  "desktopName": "OpenCraft",
  "type": "module",
  "main": "dist-host/main.cjs",
  "dependencies": {
    "@opencraft/i18n": "0.1.0",
    "@opencraft/design-system": "0.1.0",
    "@opencraft/document-storage": "0.1.0",
    "@opencraft/app-host-protocol": "0.1.0",
    "@opencraft/daemon-ipc": "0.1.0",
    "@opencraft/ui-preferences": "0.1.0",
    "@opencraft/workbench-runtime": "0.1.0",
    "@opencraft/sqlite-node": "0.1.0"
  },
  "scripts": {
    "build:host": "node build-tray.mjs && node build-native-speech.mjs && npm run build --workspace @opencraft/opencraft-daemon && esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --define:import.meta.url=import_meta_url --banner:js=\"const import_meta_url = require('node:url').pathToFileURL(__filename).href;\" --outfile=dist-host/main.cjs && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-host/preload.cjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:host && node ../../scripts/start-electron.mjs",
    "package:mac:arm64:zip": "electron-builder --mac zip --arm64",
    "package:mac:arm64:preview": "node ../../scripts/package-macos-preview.mjs arm64",
    "package:mac:arm64:dmg": "electron-builder --mac dmg --arm64",
    "package:mac:x64:zip": "electron-builder --mac zip --x64",
    "package:mac:x64:preview": "node ../../scripts/package-macos-preview.mjs x64",
    "package:mac:x64:dmg": "electron-builder --mac dmg --x64",
    "package:linux:x64:appimage": "electron-builder --linux AppImage --x64",
    "package:linux:x64:rpm": "electron-builder --linux rpm --x64",
    "package:linux:x64:deb": "electron-builder --linux deb --x64",
    "package:linux:x64": "electron-builder --linux AppImage rpm deb --x64"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "@electron/osx-sign": "1.3.3",
    "@electron/universal": "2.0.3",
    "@resvg/resvg-js": "2.6.2",
    "@types/ws": "^8.18.1",
    "electron": "44.1.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "ai.lightvela.vela",
    "productName": "OpenCraft",
    "protocols": [{ "name": "OpenCraft login", "schemes": ["opencraft"] }],
    "asar": true,
    "afterPack": "../../scripts/prepare-packaged-pty.cjs",
    "npmRebuild": false,
    "beforePack": "../../scripts/check-desktop-target.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-host/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/native", "to": "native", "filter": ["opencraft-speech-helper"] },
      { "from": "../local-agent-host/src/dsh-capability-plugin.mjs", "to": "runtime/dsh/opencraft-capability-plugin.mjs" },
      { "from": "../local-agent-host/src/dsh-skill-catalog.mjs", "to": "runtime/dsh/dsh-skill-catalog.mjs" },
      { "from": "../local-agent-host/src/dsh-skill-invocation.mjs", "to": "runtime/dsh/dsh-skill-invocation.mjs" },
      { "from": "../local-agent-host/src/dsh-thread-engine.mjs", "to": "runtime/dsh/dsh-thread-engine.mjs" },
      { "from": "../local-agent-host/src/dsh-thread-storage.mjs", "to": "runtime/dsh/dsh-thread-storage.mjs" },
      { "from": "../local-agent-host/src/dsh-thread-persistence-plugin.mjs", "to": "runtime/dsh/dsh-thread-persistence-plugin.mjs" },
      { "from": "../local-agent-host/src/dsh-thread-projection-plugin.mjs", "to": "runtime/dsh/dsh-thread-projection-plugin.mjs" },
      { "from": "../local-agent-host/src/dsh-checkpoint-store.mjs", "to": "runtime/dsh/dsh-checkpoint-store.mjs" },
      { "from": "../local-agent-host/src/dsh-generation-recovery.mjs", "to": "runtime/dsh/dsh-generation-recovery.mjs" },
      { "from": "../local-agent-host/src/dsh-capability-output.mjs", "to": "runtime/dsh/dsh-capability-output.mjs" },
      { "from": "../local-agent-host/src/hypernode/surface-checkpoint.mjs", "to": "runtime/dsh/hypernode/surface-checkpoint.mjs" },
      { "from": "build/tray", "to": "tray", "filter": ["*.png"] },
      {
        "from": "../../node_modules/node-pty",
        "to": "runtime/node_modules/node-pty",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../opencraft-daemon/dist/main.cjs",
        "to": "runtime/opencraft-daemon.cjs"
      },
      {
        "from": "../workbench-web/dist-electron",
        "to": "renderer",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../../runtime/dsh",
        "to": "runtime/dsh",
        "filter": [
          "package.json",
          "package-lock.json"
        ]
      },
      {
        "from": "../../runtime/dsh/node_modules",
        "to": "runtime/dsh/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "entitlements": "native/entitlements.mac.plist",
      "entitlementsInherit": "native/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "将麦克风语音转换为 OpenCraft 输入文字。",
        "NSSpeechRecognitionUsageDescription": "将语音转换为输入文字；系统不支持端侧识别时可能使用 Apple 语音服务。"
      },
      "category": "public.app-category.developer-tools",
      "icon": "../workbench-expo/ios/OpenCraft/Images.xcassets/AppIcon.appiconset/App-Icon-1024x1024@1x.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "../workbench-expo/ios/OpenCraft/Images.xcassets/AppIcon.appiconset/App-Icon-1024x1024@1x.png",
      "executableName": "opencraft",
      "maintainer": "OpenCraft <support@lightvela.ai>",
      "vendor": "OpenCraft",
      "synopsis": "OpenCraft agent workbench",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "rpm",
        "deb"
      ]
    },
    "dmg": {
      "artifactName": "OpenCraft-${version}-${arch}.${ext}",
      "title": "OpenCraft ${version}"
    },
    "artifactName": "OpenCraft-${version}-${os}-${arch}.${ext}"
  }
}
