{
  "name": "@opencraft/codex-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --external:node-pty --platform=node --format=cjs --outfile=dist/main.cjs && esbuild src/app-server-bin.ts --bundle --external:node-pty --platform=node --format=cjs --outfile=dist/app-server.cjs",
    "start": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencraft/local-agent-host": "0.1.0",
    "@opencraft/account-pool-host": "0.1.0",
    "ws": "^8.23.0",
    "@opencraft/sqlite-node": "0.1.0",
    "@opencraft/appserver-protocol": "0.1.0",
    "@opencraft/sandbox-node": "0.1.0",
    "@opencraft/execution-environment": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "typescript": "^6.0.3"
  },
  "exports": {
    "./operator-lease": "./src/operator-lease.ts",
    "./account-core-limits": "./src/account-core-limits.mjs",
    "./main": "./src/main.ts"
  }
}
