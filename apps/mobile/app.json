{
  "expo": {
    "name": "OpenCraft",
    "slug": "opencraft-workbench",
    "version": "0.1.0",
    "scheme": "opencraft",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.opencraft.workbench"
    },
    "android": {
      "package": "dev.opencraft.workbench",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
