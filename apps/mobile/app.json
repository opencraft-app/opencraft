{
  "expo": {
    "name": "OpenCraft",
    "slug": "opencraft-workbench",
    "version": "0.3.0",
    "scheme": "opencraft",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.opencraft.workbench"
    },
    "android": {
      "package": "dev.opencraft.workbench",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
