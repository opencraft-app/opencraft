{
  "name": "@opencraft/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "build:web-workbench": "node --import tsx scripts/build-web-workbench.mts",
    "start": "node scripts/run-expo.cjs start",
    "android": "node scripts/run-expo.cjs run:android",
    "ios": "node scripts/run-expo.cjs run:ios",
    "prebuild:ios": "node scripts/run-expo.cjs prebuild --platform ios",
    "bundle:ios": "node scripts/run-expo.cjs export:embed --platform ios --dev false --entry-file index.ts --bundle-output dist/ios/main.jsbundle --assets-dest dist/ios/assets",
    "build:ios:ipa": "bash scripts/build-ios-ipa.sh",
    "build:android:apk": "bash scripts/build-android-apk.sh",
    "build:android:release": "bash scripts/build-android-release-apk.sh",
    "licenses:generate": "node scripts/generate-mobile-open-source-licenses.mjs",
    "licenses:check": "node scripts/generate-mobile-open-source-licenses.mjs --check",
    "web": "node scripts/run-expo.cjs start --web",
    "export:web": "node scripts/run-expo.cjs export --platform web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencraft/client-product": "0.1.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@expo/metro-runtime": "~58.0.15",
    "@gorhom/bottom-sheet": "5.2.14",
    "@opencraft/design-system": "0.1.0",
    "@opencraft/mobile-bot-bridge": "0.1.0",
    "@tanstack/react-query": "^5.104.5",
    "@ungap/structured-clone": "^1.4.0",
    "expo": "58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "heroui-native": "1.0.11",
    "katex": "^0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.13.0",
    "@opencraft/design-system-native": "0.1.0",
    "expo-glass-effect": "~58.0.5",
    "@opencraft/i18n": "0.1.0",
    "@formatjs/intl-locale": "5.3.12"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/ungap__structured-clone": "^1.2.0",
    "acorn": "8.19.0",
    "compression": "^1.8.2",
    "esbuild": "^0.28.2",
    "mermaid": "^11.17.2",
    "pngjs": "7.0.0",
    "typescript": "~6.0.3"
  }
}
