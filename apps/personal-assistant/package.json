{
  "name": "@opencraft/personal-assistant",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/assistant.mjs run",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node scripts/demo.mjs",
    "format:check": "prettier --check src bin test scripts docs",
    "demo:assistant": "node scripts/demo-assistant.mjs",
    "demo:personal": "node scripts/demo-personal-assistant.mjs",
    "accept:real": "node scripts/accept-personal-assistant.mjs",
    "eval:memory": "node evaluation/longmemeval.mjs",
    "test:eval-memory": "node --test --test-concurrency=1 evaluation/*.test.mjs",
    "test:memory-mechanisms": "node --test --test-concurrency=1 test/memory-learning.test.mjs test/memory-parity.test.mjs test/memory-files.test.mjs test/conversation-context.test.mjs",
    "eval:lifecycle": "node evaluation/lifecycle-probe.mjs",
    "eval:memory-system": "node evaluation/memory-system.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@opencraft/appserver-protocol": "0.1.0",
    "@opencraft/identity-core": "0.1.0",
    "@opencraft/sandbox": "0.1.0",
    "@opencraft/worker-owner": "0.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/context-async-hooks": "2.0.1",
    "@opentelemetry/otlp-transformer": "0.301.2",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-logs": "0.201.1",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  },
  "bin": {
    "opencraft-assistant": "./bin/assistant.mjs"
  },
  "exports": {
    ".": "./src/runtime/personal-assistant.mjs",
    "./platform-port": "./src/adapters/local/platform-assistant-port.mjs",
    "./host": {
      "types": "./src/runtime/host-supervisor.d.mts",
      "import": "./src/runtime/host-supervisor.mjs"
    },
    "./sandbox": {
      "types": "./src/runtime/sandbox-environment-provider.d.mts",
      "import": "./src/runtime/sandbox-environment-provider.mjs"
    },
    "./adapters/filesystem/attachment-store": "./src/adapters/filesystem/attachment-store.mjs",
    "./adapters/local/bot-profile": "./src/adapters/local/bot-profile.mjs",
    "./runtime/host-extension": "./src/runtime/host-extension.mjs",
    "./runtime/assistant-server": "./src/runtime/assistant-server.mjs",
    "./runtime/local-runner": "./src/runtime/local-runner.mjs",
    "./store": "./src/store.mjs"
  }
}
