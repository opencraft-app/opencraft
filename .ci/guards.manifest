guards:
  - name: context-docs-impact
    paths:
      - AGENTS.md
      - user/auth/**
      - shadow/**
      - service-gateway/**
      - subscription/**
      - payment/**
      - trade/**
      - cloudladdergateway/**
      - cloudagent/**
      - ai-gateway/**
      - ctl/**
      - sandbox/**
      - velagw/**
      - velalink/**
      - workers/**
      - new-api/**
      - frontend/**
      - admin-gateway/**
      - gateway-dashboard/**
      - nextgen-dashboard/**
      - .ci/runtime/**
      - argocd/**
      - infra_pulumi/**
      - codesign/**
      - .agents/context/**
      - docs/context/decisions/**
      - docs/engineering/decisions/**
      - docs/engineering/domains/**
      - docs/engineering/journeys/**
      - docs/context/project/overview.md
      - docs/context/23-rules-matrix.md
      - docs/context/.context/**
      - .agents/skills/context-audit/**
    command: .ci/checks/context_docs_impact_guard.sh

  - name: ci-runtime
    paths:
      - .ci/**
    command: .ci/checks/guard.sh

  - name: service-gateway
    paths:
      - service-gateway/**
      - argocd/services/service-gateway/**
      - argocd/apps/*/service-gateway.yaml
      - argocd/secrets/*/service-gateway-runtime-secrets.sops.yaml
    command: .ci/checks/service-gateway_guard.sh

  - name: admin-gateway
    paths:
      - admin-gateway/**
      - argocd/services/admin-gateway/**
      - argocd/apps/*/admin-gateway.yaml
      - argocd/secrets/*/admin-gateway-runtime-secrets.sops.yaml
    command: admin-gateway/checks/guard.sh

  - name: frontend
    paths:
      - frontend/**
      - argocd/services/frontend/**
      - argocd/apps/*/frontend.yaml
    command: frontend/checks/guard.sh
