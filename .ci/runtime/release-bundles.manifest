bundles:
  admin-gateway:
    owner: admin-gateway
    source: admin-gateway
    db_contract: none
    reason: Admin gateway release bundle with an independent image tag and CI
      pipeline. It currently reuses the service-gateway Dockerfile/build context
      until the gateway binaries are split.
    allowed_paths:
    - admin-gateway/k8s/base
    - admin-gateway/k8s/overlays/beijing-sandbox
    - admin-gateway/k8s/overlays/shprod
    - service-gateway
    - service-gateway/Dockerfile
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/admin-gateway/{env}/**
    - argocd/apps/{env}/admin-gateway.yaml
    - argocd/secrets/{env}/admin-gateway-runtime-secrets.sops.yaml
    - admin-gateway/k8s/base/**
    - admin-gateway/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/admin-gateway/beijing-sandbox/**
      - argocd/services/admin-gateway/common/**
      - argocd/services/admin-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/admin-gateway.yaml
      - argocd/secrets/beijing-sandbox/admin-gateway-runtime-secrets.sops.yaml
      - admin-gateway/k8s/base/**
      - admin-gateway/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/admin-gateway/beijing-sandbox-2/**
      - argocd/services/admin-gateway/common/**
      - argocd/services/admin-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/admin-gateway.yaml
      - argocd/secrets/beijing-sandbox-2/admin-gateway-runtime-secrets.sops.yaml
      - admin-gateway/k8s/base/**
      - admin-gateway/k8s/overlays/beijing-sandbox-2/**
      - admin-gateway/k8s/overlays/beijing-sandbox/**
    dockerfile: service-gateway/Dockerfile
    build_context: service-gateway
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/admin-gateway
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/admin-gateway
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/admin-gateway
  ai-gateway:
    owner: ai-gateway
    source: ai-gateway
    db_contract:
      mode: migration
      db_job_service: ai-gateway
      migration_operation: migration
      migration_paths:
      - ai-gateway/migrations/**
      expected_migration_source: ai-gateway/migrations
      verifier:
        namespace: ai-gateway
        configmap: ai-gateway-runtime-config
        secret: ai-gateway-runtime-secrets
        database_env: AI_GATEWAY_DB
        user_env: AI_GATEWAY_DB_USER
        password_env: AI_GATEWAY_DB_PASSWORD
    reason: AI gateway backend release bundle for formal Argo-driven rollout.
    allowed_paths:
    - ai-gateway/k8s/base
    - ai-gateway/k8s/overlays/beijing-sandbox
    - ai-gateway/k8s/overlays/shprod
    - ai-gateway/deploy/Dockerfile
    - ai-gateway/openapi.yaml
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/ai-gateway/{env}/**
    - argocd/apps/{env}/ai-gateway.yaml
    - argocd/secrets/{env}/ai-gateway-runtime-secrets.sops.yaml
    - ai-gateway/k8s/base/**
    - ai-gateway/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/ai-gateway/beijing-sandbox/**
      - argocd/services/ai-gateway/common/**
      - argocd/services/ai-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/ai-gateway.yaml
      - argocd/secrets/beijing-sandbox/ai-gateway-runtime-secrets.sops.yaml
      - ai-gateway/k8s/base/**
      - ai-gateway/k8s/overlays/beijing-sandbox/**
    dockerfile: ai-gateway/deploy/Dockerfile
    build_context: .
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/ai-gateway
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/ai-gateway
  gateway-dashboard:
    owner: gateway-dashboard
    source: gateway-dashboard
    db_contract: none
    reason: Gateway dashboard formal release bundle for Argo-managed admin UI rollout.
    allowed_paths:
    - gateway-dashboard/k8s/base
    - gateway-dashboard/k8s/overlays/beijing-sandbox
    - gateway-dashboard/k8s/overlays/shprod
    - gateway-dashboard/Dockerfile
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/gateway-dashboard/{env}/**
    - argocd/apps/{env}/gateway-dashboard.yaml
    - argocd/secrets/{env}/gateway-dashboard-runtime-secrets.sops.yaml
    - gateway-dashboard/k8s/base/**
    - gateway-dashboard/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/gateway-dashboard/beijing-sandbox/**
      - argocd/services/gateway-dashboard/common/**
      - argocd/services/gateway-dashboard/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/gateway-dashboard.yaml
      - argocd/secrets/beijing-sandbox/gateway-dashboard-runtime-secrets.sops.yaml
      - gateway-dashboard/k8s/base/**
      - gateway-dashboard/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/gateway-dashboard/beijing-sandbox-2/**
      - argocd/services/gateway-dashboard/common/**
      - argocd/services/gateway-dashboard/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/gateway-dashboard.yaml
      - argocd/secrets/beijing-sandbox-2/gateway-dashboard-runtime-secrets.sops.yaml
      - gateway-dashboard/k8s/base/**
      - gateway-dashboard/k8s/overlays/beijing-sandbox-2/**
      - gateway-dashboard/k8s/overlays/beijing-sandbox/**
    dockerfile: gateway-dashboard/Dockerfile
    build_context: gateway-dashboard
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/gateway-dashboard
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/gateway-dashboard
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/gateway-dashboard
  nextgen-dashboard:
    owner: nextgen-dashboard
    source: nextgen-dashboard
    db_contract: none
    reason: Nextgen dashboard formal release bundle for Argo-managed dashboard rollout.
    allowed_paths:
    - nextgen-dashboard/k8s/base
    - nextgen-dashboard/k8s/overlays/beijing-sandbox
    - nextgen-dashboard/k8s/overlays/shprod
    - nextgen-dashboard/Dockerfile
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/nextgen-dashboard/{env}/**
    - argocd/apps/{env}/nextgen-dashboard.yaml
    - argocd/secrets/{env}/nextgen-dashboard-runtime-secrets.sops.yaml
    - nextgen-dashboard/k8s/base/**
    - nextgen-dashboard/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/nextgen-dashboard/beijing-sandbox/**
      - argocd/services/nextgen-dashboard/common/**
      - argocd/services/nextgen-dashboard/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/nextgen-dashboard.yaml
      - argocd/secrets/beijing-sandbox/nextgen-dashboard-runtime-secrets.sops.yaml
      - nextgen-dashboard/k8s/base/**
      - nextgen-dashboard/k8s/overlays/beijing-sandbox/**
    dockerfile: nextgen-dashboard/Dockerfile
    build_context: nextgen-dashboard
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/nextgen-dashboard
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/nextgen-dashboard
  payment:
    owner: payment
    source: payment
    db_contract:
      mode: migration
      db_job_service: payment
      migration_operation: migration
      migration_paths:
      - payment/migrations/**
      expected_migration_source: payment/migrations
      verifier:
        namespace: user-auth
        configmap: payment-config
        secret: payment-runtime-secrets
        database_env: PAYMENT_DB
        user_env: PAYMENT_DB_USER
        password_env: PAYMENT_DB_PASSWORD
    reason: Payment service formal release bundle for Argo-managed rollout and DB
      job contract.
    allowed_paths:
    - payment/k8s/base
    - payment/k8s/overlays/beijing-sandbox
    - payment/k8s/overlays/shprod
    - payment/Dockerfile
    - payment/migrations
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/payment/{env}/**
    - argocd/apps/{env}/payment.yaml
    - argocd/secrets/{env}/payment-runtime-secrets.sops.yaml
    - payment/k8s/base/**
    - payment/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/payment/beijing-sandbox/**
      - argocd/services/payment/common/**
      - argocd/services/payment/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/payment.yaml
      - argocd/secrets/beijing-sandbox/payment-runtime-secrets.sops.yaml
      - payment/k8s/base/**
      - payment/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/payment/beijing-sandbox-2/**
      - argocd/services/payment/common/**
      - argocd/services/payment/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/payment.yaml
      - argocd/secrets/beijing-sandbox-2/payment-runtime-secrets.sops.yaml
      - payment/k8s/base/**
      - payment/k8s/overlays/beijing-sandbox-2/**
      - payment/k8s/overlays/beijing-sandbox/**
    dockerfile: payment/Dockerfile
    build_context: payment
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/payment
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/payment
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/payment
  service-gateway:
    owner: service-gateway
    source: service-gateway
    db_contract: none
    release_dependencies:
    - lightclaw-auth
    - payment
    - subscription
    reason: Public gateway formal release bundle for Argo-managed routing rollout.
    allowed_paths:
    - service-gateway/k8s/base
    - service-gateway/k8s/overlays/beijing-sandbox
    - service-gateway/k8s/overlays/shprod
    - service-gateway/Dockerfile
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/service-gateway/{env}/**
    - argocd/apps/{env}/service-gateway.yaml
    - argocd/secrets/{env}/service-gateway-runtime-secrets.sops.yaml
    - service-gateway/k8s/base/**
    - service-gateway/k8s/overlays/{env}/**
    publish_paths_by_env:
      shprod:
      - argocd/services/service-gateway/shprod/**
      - argocd/apps/shprod/service-gateway.yaml
      - argocd/secrets/shprod/service-gateway-runtime-secrets.sops.yaml
      - service-gateway/k8s/base/**
      - service-gateway/k8s/overlays/shprod/**
      beijing-sandbox:
      - argocd/services/service-gateway/beijing-sandbox/**
      - argocd/services/service-gateway/common/**
      - argocd/services/service-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/service-gateway.yaml
      - argocd/secrets/beijing-sandbox/service-gateway-runtime-secrets.sops.yaml
      - service-gateway/k8s/base/**
      - service-gateway/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/service-gateway/beijing-sandbox-2/**
      - argocd/services/service-gateway/common/**
      - argocd/services/service-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/service-gateway.yaml
      - argocd/secrets/beijing-sandbox-2/service-gateway-runtime-secrets.sops.yaml
      - service-gateway/k8s/base/**
      - service-gateway/k8s/overlays/beijing-sandbox-2/**
      - service-gateway/k8s/overlays/beijing-sandbox/**
    dockerfile: service-gateway/Dockerfile
    build_context: service-gateway
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/service-gateway
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/service-gateway
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/service-gateway
  session:
    owner: session
    source: session
    db_contract: none
    reason: Session service release bundle import for formal Argo-managed rollout.
    allowed_paths:
    - session/k8s/base
    - session/k8s/overlays/beijing-sandbox
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/session/{env}/**
    - argocd/apps/{env}/session.yaml
    - argocd/secrets/{env}/session-runtime-secrets.sops.yaml
    - session/k8s/base/**
    - session/k8s/overlays/{env}/**
  subscription:
    owner: subscription
    source: subscription
    db_contract:
      mode: migration
      db_job_service: subscription
      migration_operation: migration
      migration_paths:
      - subscription/migrations/**
      expected_migration_source: subscription/migrations
      verifier:
        namespace: user-auth
        configmap: subscription-config
        secret: subscription-runtime-secrets
        database_env: SUBSCRIPTION_DB
        user_env: SUBSCRIPTION_DB_USER
        password_env: SUBSCRIPTION_DB_PASSWORD
        baseline_checks:
        - name: subscription-plans-free-lite-pro
          query: SELECT COUNT(*) FROM subscription_plans WHERE code IN ('free','lite','pro')
          expected: "3"
    reason: Subscription service formal release bundle for Argo-managed rollout and
      DB job contract.
    allowed_paths:
    - subscription/k8s/base
    - subscription/k8s/overlays/beijing-sandbox
    - subscription/k8s/overlays/shprod
    - subscription/Dockerfile
    - subscription/migrations
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/subscription/{env}/**
    - argocd/apps/{env}/subscription.yaml
    - argocd/secrets/{env}/subscription-runtime-secrets.sops.yaml
    - subscription/k8s/base/**
    - subscription/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/subscription/beijing-sandbox/**
      - argocd/services/subscription/common/**
      - argocd/services/subscription/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/subscription.yaml
      - argocd/secrets/beijing-sandbox/subscription-runtime-secrets.sops.yaml
      - subscription/k8s/base/**
      - subscription/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/subscription/beijing-sandbox-2/**
      - argocd/services/subscription/common/**
      - argocd/services/subscription/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/subscription.yaml
      - argocd/secrets/beijing-sandbox-2/subscription-runtime-secrets.sops.yaml
      - subscription/k8s/base/**
      - subscription/k8s/overlays/beijing-sandbox-2/**
      - subscription/k8s/overlays/beijing-sandbox/**
    dockerfile: subscription/Dockerfile
    build_context: subscription
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/subscription
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/subscription
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/subscription
  user-auth:
    owner: user/auth
    source: user/auth
    db_contract:
      mode: migration
      db_job_service: lightclaw-auth
      migration_operation: migration
      seed_operation: seed
      seed_required: false
      migration_paths:
      - user/auth/migrations/**
      expected_migration_source: user/auth/migrations
      verifier:
        namespace: user-auth
        configmap: lightclaw-auth-config
        secret: lightclaw-auth-secrets
        database_env: LIGHTCLAW_AUTH_DB
        user_env: LIGHTCLAW_AUTH_DB_USER
        password_env: LIGHTCLAW_AUTH_DB_PASSWORD
    reason: User auth formal release bundle for Argo-managed rollout and DB job contract.
    allowed_paths:
    - user/auth/k8s/base
    - user/auth/k8s/overlays/beijing-sandbox
    - user/auth/k8s/overlays/shprod
    - user/auth/Dockerfile
    - user/auth/migrations
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/lightclaw-auth/{env}/**
    - argocd/apps/{env}/lightclaw-auth.yaml
    - argocd/secrets/{env}/lightclaw-auth-secrets.sops.yaml
    - user/auth/k8s/base/**
    - user/auth/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/lightclaw-auth/beijing-sandbox/**
      - argocd/services/lightclaw-auth/common/**
      - argocd/services/lightclaw-auth/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/lightclaw-auth.yaml
      - argocd/secrets/beijing-sandbox/lightclaw-auth-secrets.sops.yaml
      - user/auth/k8s/base/**
      - user/auth/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/lightclaw-auth/beijing-sandbox-2/**
      - argocd/services/lightclaw-auth/common/**
      - argocd/services/lightclaw-auth/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/lightclaw-auth.yaml
      - argocd/secrets/beijing-sandbox-2/lightclaw-auth-secrets.sops.yaml
      - user/auth/k8s/base/**
      - user/auth/k8s/overlays/beijing-sandbox-2/**
      - user/auth/k8s/overlays/beijing-sandbox/**
    dockerfile: user/auth/Dockerfile
    build_context: user/auth
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/lightclaw-auth
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/lightclaw-auth
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/lightclaw-auth
  ctl:
    owner: ctl
    source: ctl
    db_contract:
      mode: migration
      db_job_service: ctl
      migration_operation: migration
      readiness_supported: false
      migration_paths:
      - ctl/migrations/**
      expected_migration_source: ctl/migrations
    reason: CTL formal release bundle for Argo-managed rollout.
    allowed_paths:
    - ctl/k8s/base
    - ctl/k8s/overlays/beijing-sandbox
    - ctl/k8s/overlays/shprod
    - ctl/Dockerfile
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/ctl/{env}/**
    - argocd/apps/{env}/ctl.yaml
    - argocd/secrets/{env}/ctl-conf-common.sops.yaml
    - argocd/secrets/{env}/ctl-conf-rewrite.sops.yaml
    - argocd/secrets/{env}/ctl-runtime-secrets.sops.yaml
    - ctl/k8s/base/**
    - ctl/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/ctl/beijing-sandbox/**
      - argocd/services/ctl/common/**
      - argocd/services/ctl/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/ctl.yaml
      - argocd/secrets/beijing-sandbox/ctl-conf-common.sops.yaml
      - argocd/secrets/beijing-sandbox/ctl-conf-rewrite.sops.yaml
      - argocd/secrets/beijing-sandbox/ctl-runtime-secrets.sops.yaml
      - ctl/k8s/base/**
      - ctl/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/ctl/beijing-sandbox-2/**
      - argocd/services/ctl/common/**
      - argocd/services/ctl/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/ctl.yaml
      - argocd/secrets/beijing-sandbox-2/ctl-conf-common.sops.yaml
      - argocd/secrets/beijing-sandbox-2/ctl-conf-rewrite.sops.yaml
      - argocd/secrets/beijing-sandbox-2/ctl-runtime-secrets.sops.yaml
      - ctl/k8s/base/**
      - ctl/k8s/overlays/beijing-sandbox-2/**
      - ctl/k8s/overlays/beijing-sandbox/**
    dockerfile: ctl/Dockerfile
    build_context: ctl
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/ctl
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/ctl
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/ctl
  sandbox:
    owner: sandbox
    source: sandbox
    db_contract:
      mode: migration
      db_job_service: sandbox
      migration_operation: migration
      migration_image_key: SANDBOX_MIGRATE_IMAGE
      migration_paths:
      - sandbox/migrations/**
      expected_migration_source: sandbox/migrations
      always_verify_baseline: true
      verifier:
        namespace: sandbox
        configmap: sandbox-runtime-config
        secret: sandbox-runtime-secrets
        database_env: MYSQL_DB
        user_env: MYSQL_USER
        password_env: MYSQL_PASSWORD
        baseline_checks:
        - name: sandbox-pools-present
          query: SELECT COUNT(*) FROM pools
          min: 1
          failure_hint: Run ENV=<env> bash sandbox/scripts/sync-default-pools.sh --base-image <img-id> after confirming the target base image.
    reason: Sandbox formal release bundle for future Argo-managed rollout.
    allowed_paths:
    - sandbox/k8s/base
    - sandbox/k8s/overlays/beijing-sandbox
    - sandbox/k8s/overlays/shprod
    - sandbox/config
    - sandbox/migrations
