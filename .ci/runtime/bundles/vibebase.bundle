bundles:
  vibebase:
    owner: vibebase
    source: vibebase
    db_contract: none
    reason: Redis-backed per-user KV service for private user and agent state.
    allowed_paths:
    - vibebase/k8s/base
    - vibebase/k8s/overlays/beijing-sandbox
    - vibebase/Dockerfile
    exit_condition: Can be removed only after Vibebase is folded into a different durable state service.
    publish_paths:
    - argocd/services/vibebase/{env}/**
    - argocd/services/vibebase/common/**
    - argocd/catalogs/sandbox/{env}/vibebase.yaml
    - argocd/secrets/{env}/vibebase-runtime-secrets.sops.yaml
    - vibebase/k8s/base/**
    - vibebase/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/services/vibebase/beijing-sandbox/**
      - argocd/services/vibebase/common/**
      - argocd/services/service-gateway/beijing-sandbox/config.yaml
      - argocd/services/service-gateway/beijing-sandbox/kustomization.yaml
      - argocd/services/service-gateway/beijing-sandbox/service-gateway-platform.env
      - argocd/catalogs/sandbox/beijing-sandbox/vibebase.yaml
      - argocd/secrets/beijing-sandbox/vibebase-runtime-secrets.sops.yaml
      - vibebase/k8s/base/**
      - vibebase/k8s/overlays/beijing-sandbox/**
      - service-gateway/k8s/base/**
    dockerfile: vibebase/Dockerfile
    build_context: vibebase
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/vibebase
