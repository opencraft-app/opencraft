bundles:
  sandbox:
    owner: sandbox
    source: sandbox
    db_contract:
      mode: migration
      db_job_service: sandbox
      migration_operation: migration
      migration_image_key: SANDBOX_MIGRATE_IMAGE
      migration_paths:
      - sandbox/migrations/**
      expected_migration_source: sandbox/migrations
      always_verify_baseline: true
      verifier:
        namespace: sandbox
        configmap: sandbox-runtime-config
        secret: sandbox-runtime-secrets
        database_env: MYSQL_DB
        user_env: MYSQL_USER
        password_env: MYSQL_PASSWORD
        baseline_checks:
        - name: sandbox-pools-present
          query: SELECT COUNT(*) FROM pools
          min: 1
          failure_hint: Run ENV=<env> bash sandbox/scripts/sync-default-pools.sh --base-image
            <img-id> after confirming the target base image.
    reason: Sandbox formal release bundle for future Argo-managed rollout.
    allowed_paths:
    - sandbox/k8s/base
    - sandbox/k8s/overlays/beijing-sandbox
    - sandbox/k8s/overlays/shprod
    - sandbox/k8s/overlays/sgprod
    - sandbox/config
    - sandbox/migrations
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/sandbox/{env}/**
    - argocd/apps/{env}/sandbox.yaml
    - argocd/secrets/{env}/sandbox-runtime-secrets.sops.yaml
    - sandbox/k8s/base/**
    - sandbox/k8s/overlays/{env}/**
    publish_paths_by_env:
      shprod:
      - argocd/services/sandbox/shprod/**
      - argocd/apps/shprod/sandbox.yaml
      - argocd/secrets/shprod/sandbox-runtime-secrets.sops.yaml
      - sandbox/k8s/base/**
      - sandbox/k8s/overlays/shprod/**
      - sandbox/k8s/overlays/sgprod/**
      beijing-sandbox:
      - argocd/services/sandbox/beijing-sandbox/**
      - argocd/services/sandbox/common/**
      - argocd/services/sandbox/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/sandbox.yaml
      - argocd/secrets/beijing-sandbox/sandbox-runtime-secrets.sops.yaml
      - sandbox/k8s/base/**
      - sandbox/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/sandbox/beijing-sandbox-2/**
      - argocd/services/sandbox/common/**
      - argocd/services/sandbox/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/sandbox.yaml
      - argocd/secrets/beijing-sandbox-2/sandbox-runtime-secrets.sops.yaml
      - sandbox/k8s/base/**
      - sandbox/k8s/overlays/beijing-sandbox-2/**
      - sandbox/k8s/overlays/beijing-sandbox/**
    image_targets:
    - name: api
      image_key: SANDBOX_API_IMAGE
      dockerfile: sandbox/Dockerfile.api
      build_context: sandbox
      image_repo:
        beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-api
        beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-api
        shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/sandbox-api
        sgprod: lightclaw-sgprod.tencentcloudcr.com/lightclaw/sandbox-api
        sandbox-kr-*: lightclaw-kr1.tencentcloudcr.com/lightclaw/sandbox-api
        sandbox-jp-*: lightclaw-jp1.tencentcloudcr.com/lightclaw/sandbox-api
    - name: migrate
      image_key: SANDBOX_MIGRATE_IMAGE
      dockerfile: sandbox/Dockerfile.migrate
      build_context: sandbox
      image_repo:
        beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-migrate
        beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-migrate
        shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/sandbox-migrate
        sgprod: lightclaw-sgprod.tencentcloudcr.com/lightclaw/sandbox-migrate
        sandbox-kr-*: lightclaw-kr1.tencentcloudcr.com/lightclaw/sandbox-migrate
        sandbox-jp-*: lightclaw-jp1.tencentcloudcr.com/lightclaw/sandbox-migrate
    - name: worker
      image_key: SANDBOX_WORKER_IMAGE
      dockerfile: sandbox/Dockerfile.worker
      build_context: sandbox
      image_repo:
        beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-worker
        beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-worker
        shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/sandbox-worker
        sgprod: lightclaw-sgprod.tencentcloudcr.com/lightclaw/sandbox-worker
        sandbox-kr-*: lightclaw-kr1.tencentcloudcr.com/lightclaw/sandbox-worker
        sandbox-jp-*: lightclaw-jp1.tencentcloudcr.com/lightclaw/sandbox-worker
    - name: ingressproxy-router
      image_key: SANDBOX_INGRESSPROXY_ROUTER_IMAGE
      dockerfile: sandbox/Dockerfile.ingressproxy-router
      build_context: sandbox
      image_repo:
        beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-router
        beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-router
        shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-router
        sgprod: lightclaw-sgprod.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-router
        sandbox-kr-*: lightclaw-kr1.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-router
        sandbox-jp-*: lightclaw-jp1.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-router
    - name: ingressproxy-shard
      image_key: SANDBOX_INGRESSPROXY_SHARD_IMAGE
      dockerfile: sandbox/Dockerfile.ingressproxy-shard
      build_context: sandbox
      image_repo:
        beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-shard
        beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-shard
        shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-shard
        sgprod: lightclaw-sgprod.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-shard
        sandbox-kr-*: lightclaw-kr1.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-shard
        sandbox-jp-*: lightclaw-jp1.tencentcloudcr.com/lightclaw/sandbox-ingressproxy-shard
