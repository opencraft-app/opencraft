bundles:
  trade:
    owner: trade
    source: trade
    db_contract:
      mode: migration
      db_job_service: trade
      migration_operation: migration
      migration_paths:
      - trade/migrations/**
      expected_migration_source: trade/migrations
      verifier:
        namespace: trade
        configmap: trade-config
        secret: trade-runtime-secrets
        database_env: TRADE_DB
        user_env: TRADE_DB_USER
        password_env: TRADE_DB_PASSWORD
    release_dependencies:
    - ctl
    - shadow
    reason: Trade service formal release bundle for Argo-managed rollout and DB
      job contract; mirrors payment bundle for golang-migrate iofs migrations.
    allowed_paths:
    - trade/k8s/base
    - trade/Dockerfile
    - trade/migrations
    exit_condition: Can be removed only after trade is folded into another billing
      runtime and no longer ships as an independent service.
    publish_paths:
      - argocd/services/trade/{env}/**
      - argocd/services/trade/common/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/playground/beijing-playground/{env}/trade.yaml
      - argocd/secrets/{env}/trade-runtime-secrets.sops.yaml
      - trade/k8s/base/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/trade/beijing-sandbox/**
      - argocd/services/trade/common/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/trade.yaml
      - argocd/secrets/beijing-sandbox/trade-runtime-secrets.sops.yaml
      - trade/k8s/base/**
    dockerfile: trade/Dockerfile
    build_context: trade
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/trade
      sandbox-kr-*: lightclaw-kr1.tencentcloudcr.com/lightclaw/trade
