bundles:
  staticpages:
    owner: staticpages
    source: third_party/staticpages
    db_contract: none
    reason: StaticPages preview hosting service for Beijing sandbox frontend branch previews.
    allowed_paths:
      - staticpages/Dockerfile
      - staticpages/k8s/base
      - third_party/staticpages
    exit_condition: Can be removed only after frontend preview hosting is moved to a managed platform.
    publish_paths_by_env:
      beijing-sandbox:
        - argocd/services/staticpages/beijing-sandbox/**
        - argocd/services/staticpages/common/**
        - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
        - argocd/catalogs/sandbox/beijing-sandbox/staticpages.yaml
        - argocd/secrets/beijing-sandbox/staticpages-runtime-secrets.sops.yaml
        - staticpages/k8s/base/**
    dockerfile: staticpages/Dockerfile
    build_context: .
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/staticpages
      sandbox-jp-*: lightclaw-jp1.tencentcloudcr.com/lightclaw/staticpages
