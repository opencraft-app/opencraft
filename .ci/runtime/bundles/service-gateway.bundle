bundles:
  service-gateway:
    owner: service-gateway
    source: service-gateway
    db_contract: none
    release_dependencies:
    - lightclaw-auth
    - payment
    - subscription
    reason: Public gateway formal release bundle for Argo-managed routing rollout.
    allowed_paths:
    - service-gateway/k8s/base
    - service-gateway/k8s/overlays/beijing-sandbox
    - service-gateway/k8s/overlays/shprod
    - service-gateway/k8s/overlays/sgprod
    - service-gateway/Dockerfile
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/service-gateway/{env}/**
    - argocd/apps/{env}/service-gateway.yaml
    - argocd/secrets/{env}/service-gateway-runtime-secrets.sops.yaml
    - service-gateway/k8s/base/**
    - service-gateway/k8s/overlays/{env}/**
    publish_paths_by_env:
      shprod:
      - argocd/services/service-gateway/shprod/**
      - argocd/apps/shprod/service-gateway.yaml
      - argocd/secrets/shprod/service-gateway-runtime-secrets.sops.yaml
      - service-gateway/k8s/base/**
      - service-gateway/k8s/overlays/shprod/**
      - service-gateway/k8s/overlays/sgprod/**
      beijing-sandbox:
      - argocd/services/service-gateway/beijing-sandbox/**
      - argocd/services/service-gateway/common/**
      - argocd/services/service-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/service-gateway.yaml
      - argocd/secrets/beijing-sandbox/service-gateway-runtime-secrets.sops.yaml
      - service-gateway/k8s/base/**
      - service-gateway/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/service-gateway/beijing-sandbox-2/**
      - argocd/services/service-gateway/common/**
      - argocd/services/service-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/service-gateway.yaml
      - argocd/secrets/beijing-sandbox-2/service-gateway-runtime-secrets.sops.yaml
      - service-gateway/k8s/base/**
      - service-gateway/k8s/overlays/beijing-sandbox-2/**
      - service-gateway/k8s/overlays/beijing-sandbox/**
    dockerfile: service-gateway/Dockerfile
    build_context: service-gateway
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/service-gateway
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/service-gateway
      sgprod: lightclaw-sgprod.tencentcloudcr.com/lightclaw/service-gateway
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/service-gateway
      sandbox-kr-*: lightclaw-kr1.tencentcloudcr.com/lightclaw/service-gateway
      sandbox-jp-*: lightclaw-jp1.tencentcloudcr.com/lightclaw/service-gateway
