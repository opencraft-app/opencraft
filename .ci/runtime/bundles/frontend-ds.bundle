bundles:
  frontend-ds:
    owner: frontend-ds
    source: frontend-ds
    db_contract: none
    reason: Frontend DS formal release bundle for Argo-managed rollout.
    allowed_paths:
    - frontend-ds/k8s/base
    - frontend-ds/k8s/overlays/shprod
    - frontend-ds/deploy/Dockerfile
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/frontend-ds/{env}/**
    - argocd/apps/{env}/frontend-ds.yaml
    - frontend-ds/k8s/base/**
    - frontend-ds/k8s/overlays/{env}/**
    dockerfile: frontend-ds/deploy/Dockerfile
    build_context: frontend-ds
    image_repo:
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/frontend-ds
    publish_paths_by_env: {}
