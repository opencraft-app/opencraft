bundles:
  ai-gateway:
    owner: ai-gateway
    source: ai-gateway
    db_contract:
      mode: migration
      db_job_service: ai-gateway
      migration_operation: migration
      migration_paths:
      - ai-gateway/migrations/**
      expected_migration_source: ai-gateway/migrations
      verifier:
        namespace: ai-gateway
        configmap: ai-gateway-runtime-config
        secret: ai-gateway-runtime-secrets
        database_env: AI_GATEWAY_DB
        user_env: AI_GATEWAY_DB_USER
        password_env: AI_GATEWAY_DB_PASSWORD
    reason: AI gateway backend release bundle for formal Argo-driven rollout.
    allowed_paths:
    - ai-gateway/k8s/base
    - ai-gateway/k8s/overlays/beijing-sandbox
    - ai-gateway/k8s/overlays/beijing-sandbox-2
    - ai-gateway/k8s/overlays/shprod
    - ai-gateway/k8s/overlays/sgprod
    - ai-gateway/deploy/Dockerfile
    - ai-gateway/openapi.yaml
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/ai-gateway/{env}/**
    - argocd/apps/{env}/ai-gateway.yaml
    - argocd/secrets/{env}/ai-gateway-runtime-secrets.sops.yaml
    - ai-gateway/k8s/base/**
    - ai-gateway/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/ai-gateway/beijing-sandbox/**
      - argocd/services/ai-gateway/common/**
      - argocd/services/ai-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/ai-gateway.yaml
      - argocd/secrets/beijing-sandbox/ai-gateway-runtime-secrets.sops.yaml
      - ai-gateway/k8s/base/**
      - ai-gateway/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/ai-gateway/beijing-sandbox-2/**
      - argocd/services/ai-gateway/common/**
      - argocd/services/ai-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/ai-gateway.yaml
      - argocd/secrets/beijing-sandbox-2/ai-gateway-runtime-secrets.sops.yaml
      - ai-gateway/k8s/base/**
      - ai-gateway/k8s/overlays/beijing-sandbox/**
    dockerfile: ai-gateway/deploy/Dockerfile
    build_context: .
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/ai-gateway
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/ai-gateway
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/ai-gateway
      sgprod: lightclaw-sgprod.tencentcloudcr.com/lightclaw/ai-gateway
