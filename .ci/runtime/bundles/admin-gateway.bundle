bundles:
  admin-gateway:
    owner: admin-gateway
    source: admin-gateway
    db_contract: none
    reason: Admin gateway release bundle with an independent image tag and CI pipeline.
      It currently reuses the service-gateway Dockerfile/build context until the gateway
      binaries are split.
    allowed_paths:
    - admin-gateway/k8s/base
    - admin-gateway/k8s/overlays/beijing-sandbox
    - admin-gateway/k8s/overlays/shprod
    - service-gateway
    - service-gateway/Dockerfile
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/admin-gateway/{env}/**
    - argocd/apps/{env}/admin-gateway.yaml
    - argocd/secrets/{env}/admin-gateway-runtime-secrets.sops.yaml
    - admin-gateway/k8s/base/**
    - admin-gateway/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/admin-gateway/beijing-sandbox/**
      - argocd/services/admin-gateway/common/**
      - argocd/services/admin-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/admin-gateway.yaml
      - argocd/secrets/beijing-sandbox/admin-gateway-runtime-secrets.sops.yaml
      - admin-gateway/k8s/base/**
      - admin-gateway/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/admin-gateway/beijing-sandbox-2/**
      - argocd/services/admin-gateway/common/**
      - argocd/services/admin-gateway/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/admin-gateway.yaml
      - argocd/secrets/beijing-sandbox-2/admin-gateway-runtime-secrets.sops.yaml
      - admin-gateway/k8s/base/**
      - admin-gateway/k8s/overlays/beijing-sandbox-2/**
      - admin-gateway/k8s/overlays/beijing-sandbox/**
    dockerfile: service-gateway/Dockerfile
    build_context: service-gateway
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/admin-gateway
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/admin-gateway
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/admin-gateway
