bundles:
  channelgateway:
    owner: cloudagent
    source: cloudagent/channelgateway
    db_contract: none
    reason: Channel bridge release bundle for DevCloud serverless agent entrypoints.
    allowed_paths:
    - cloudagent/channelgateway
    - cloudagent/acp-client
    exit_condition: Can be removed only after channel ingress is folded into CloudAgent gateway.
    publish_paths:
    - argocd/services/channelgateway/{env}/**
    - argocd/apps/{env}/channelgateway.yaml
    - argocd/secrets/{env}/channelgateway-runtime-secrets.sops.yaml
    - argocd/secrets/{env}/channelgateway-wecom-secrets.sops.yaml
    dockerfile: cloudagent/channelgateway/Dockerfile
    build_context: .
    image_repo:
      devcloud-dep: csighub.tencentyun.com/skipzhang/channelgateway
