bundles:
  payment:
    owner: payment
    source: payment
    db_contract:
      mode: migration
      db_job_service: payment
      migration_operation: migration
      migration_paths:
      - payment/migrations/**
      expected_migration_source: payment/migrations
      verifier:
        namespace: user-auth
        configmap: payment-config
        secret: payment-runtime-secrets
        database_env: PAYMENT_DB
        user_env: PAYMENT_DB_USER
        password_env: PAYMENT_DB_PASSWORD
    reason: Payment service formal release bundle for Argo-managed rollout and DB
      job contract.
    allowed_paths:
    - payment/k8s/base
    - payment/k8s/overlays/beijing-sandbox
    - payment/k8s/overlays/shprod
    - payment/k8s/overlays/sgprod
    - payment/Dockerfile
    - payment/migrations
    exit_condition: Can be removed only after the deployable contract moves to an
      explicit imported package path.
    publish_paths:
    - argocd/services/payment/{env}/**
    - argocd/apps/{env}/payment.yaml
    - argocd/secrets/{env}/payment-runtime-secrets.sops.yaml
    - payment/k8s/base/**
    - payment/k8s/overlays/{env}/**
    publish_paths_by_env:
      beijing-sandbox:
      - argocd/services/payment/beijing-sandbox/**
      - argocd/services/payment/common/**
      - argocd/services/payment/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox/payment.yaml
      - argocd/secrets/beijing-sandbox/payment-runtime-secrets.sops.yaml
      - payment/k8s/base/**
      - payment/k8s/overlays/beijing-sandbox/**
      beijing-sandbox-2:
      - argocd/services/payment/beijing-sandbox-2/**
      - argocd/services/payment/common/**
      - argocd/services/payment/profiles/sandbox/**
      - argocd/apps/beijing-sandbox/sandbox-family-appset.yaml
      - argocd/catalogs/sandbox/beijing-sandbox-2/payment.yaml
      - argocd/secrets/beijing-sandbox-2/payment-runtime-secrets.sops.yaml
      - payment/k8s/base/**
      - payment/k8s/overlays/beijing-sandbox-2/**
      - payment/k8s/overlays/beijing-sandbox/**
    dockerfile: payment/Dockerfile
    build_context: payment
    image_repo:
      beijing-sandbox: lightclaw-bj8.tencentcloudcr.com/lightclaw/payment
      shprod: lightclaw-shprod.tencentcloudcr.com/lightclaw/payment
      sgprod: lightclaw-sgprod.tencentcloudcr.com/lightclaw/payment
      beijing-sandbox-2: lightclaw-bj8.tencentcloudcr.com/lightclaw/payment
