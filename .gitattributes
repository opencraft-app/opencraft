# Every text file is checked out with LF on every platform: migration SQL, snapshots and SQL
# embedded in source are checksummed byte for byte, and Windows checkouts would otherwise convert them.
* text=auto eol=lf

tests/fixtures/structured/*.csv -text whitespace=cr-at-eol

vendor/electron/** -text
vendor/electron/patches/** whitespace=-blank-at-eol,-blank-at-eof
