{
	// Production-cell template. Credentials are injected through a root-only
	// EnvironmentFile and are intentionally not stored here.
	"runtime": {
		"gasoline_cell_namespace": "actor-bj-a01"
	},
	"foundation_db": {
		"cluster_file": "/etc/actor/rivet-workerd/fdb.cluster",
		"transaction_retry_limit": 10,
		"allow_shared_cluster": false
  },
  "memory": {},
  "sqlite": {
    "unstable_disable_compaction": false,
    "workflow_cold_storage": {
      "s3": {
        "bucket": "actor-depot-cold-prod-bj-a01-nv1-1388575217",
        "endpoint": "https://cos.ap-beijing.myqcloud.com",
        "region": "ap-beijing",
        "addressing_style": "virtual_hosted",
        "recovery_window_ms": 604800000,
        "max_object_size_bytes": 4194304,
        "max_concurrent_requests": 16,
        "max_queued_requests": 64,
        "queue_timeout_ms": 15000
      }
    }
  }
}
