# Minimal single-vCPU PVM Linux guest. Start from `make allnoconfig`.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_MULTIUSER=y
CONFIG_EXPERT=y
CONFIG_SPECULATION_MITIGATIONS=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_X86_PIE=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_PVM_GUEST=y
# CONFIG_SMP is not set
# CONFIG_MODULES is not set
# CONFIG_KASAN is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set

CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
# CONFIG_VT is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# CONFIG_SERIAL_8250_DEPRECATED_OPTIONS is not set
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_ISA_DMA_API is not set
# CONFIG_PCSPKR_PLATFORM is not set

CONFIG_BLK_DEV_INITRD=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# A host-sealed EROFS image is exposed as an E820 type-12 range. Linux's
# native legacy-PMEM path turns it into /dev/pmem0 and supplies fs-DAX without
# a virtio device, host read hypercall, or guest page-cache copy.
CONFIG_SPARSEMEM_MANUAL=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_MIGRATION=y
CONFIG_ZONE_DEVICE=y
CONFIG_X86_PMEM_LEGACY=y
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_DAX=y
CONFIG_FS_DAX=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
# CONFIG_EROFS_FS_POSIX_ACL is not set
# CONFIG_EROFS_FS_SECURITY is not set
# CONFIG_EROFS_FS_ZIP is not set
# CONFIG_EROFS_FS_ONDEMAND is not set
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y

CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_ANON_INODES=y
CONFIG_IO_URING=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_INET_DIAG is not set
# CONFIG_IPV6 is not set
CONFIG_PVM_SOCKET=y

CONFIG_VIRT_DRIVERS=y
CONFIG_PAGE_REPORTING=y
CONFIG_MINISANDBOX_GUEST=y
