# Copy this file to /root/code/mono/.secret/ctl/test.env and fill in real values.
# Keep the copied file out of git.
# MySQL/Redis passwords now default from deploy/envs/<env>/platform.env.
# Only keep CTL-specific values here.

CTL_TEST_AIGATEWAY_ADMIN_TOKEN="replace-with-ai-gateway-admin-token"
CTL_TEST_AIGATEWAY_INTERNAL_TOKEN="replace-with-ai-gateway-internal-token"
CTL_TEST_LLMGATEWAY_ADMIN_TOKEN="replace-with-llmgateway-admin-token"
CTL_TEST_LLMGATEWAY_INTERNAL_TOKEN="replace-with-llmgateway-internal-token"
# Comma-separated exact business user IDs. Use "*" only for an intentional full rollout.
CTL_LLMGATEWAY_NEW_USER_ALLOWLIST="usr-canary"
# Existing ai-gateway users migrate on renewal. Use "*" for all non-empty user IDs.
CTL_LLMGATEWAY_RENEWAL_MIGRATION_ALLOWLIST="usr-canary"
CTL_TEST_SHADOW_TOKEN="replace-with-shadow-internal-token"
CTL_INTERNAL_TOKEN="replace-with-ctl-internal-token"
