# Copy this file to /root/code/mono/.secret/ctl/local.env and fill in real values.
# Keep the copied file out of git.

CTL_LOCAL_MYSQL_ROOT_PASSWORD="replace-with-local-mysql-password"
CTL_LOCAL_DB_PASSWORD_ENC="replace-with-EncryptString(mysql-password)"
CTL_LOCAL_REDIS_PASSWORD="replace-with-local-redis-password"
CTL_LOCAL_REDIS_PASSWORD_ENC="replace-with-EncryptString(redis-password)"
CTL_LOCAL_GRAFANA_ADMIN_PASSWORD="replace-with-grafana-admin-password"
CTL_LOCAL_GRAFANA_CLS_SECRET_ID="replace-with-cls-secret-id"
CTL_LOCAL_GRAFANA_CLS_SECRET_KEY="replace-with-cls-secret-key"
