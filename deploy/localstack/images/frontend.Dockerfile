FROM node:22-alpine AS build

WORKDIR /workspace/frontend

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/.npmrc ./
COPY frontend/tsconfig.json frontend/tsconfig.app.json frontend/next-env.d.ts frontend/next.config.mjs frontend/postcss.config.mjs frontend/source.config.ts frontend/mdx-components.tsx ./
COPY frontend/public ./public
COPY frontend/scripts ./scripts
COPY frontend/src ./src
COPY frontend/next-site ./next-site
COPY frontend/vendor ./vendor
COPY frontend/assets ./assets
COPY frontend/patches ./patches
COPY velalink /workspace/velalink

ARG VITE_AUTH_API_BASE_URL
ARG NEXT_PUBLIC_AUTH_API_BASE_URL
ARG VITE_REGION=cn
ARG NEXT_PUBLIC_REGION=cn
ENV VITE_AUTH_API_BASE_URL="${VITE_AUTH_API_BASE_URL}"
ENV NEXT_PUBLIC_AUTH_API_BASE_URL="${NEXT_PUBLIC_AUTH_API_BASE_URL}"
ENV VITE_REGION="${VITE_REGION}"
ENV NEXT_PUBLIC_REGION="${NEXT_PUBLIC_REGION}"

ARG VITE_AEGIS_ENABLED=false
ARG VITE_AEGIS_ID
ARG VITE_AEGIS_HOST_URL
ARG NEXT_PUBLIC_AEGIS_ENABLED=false
ARG NEXT_PUBLIC_AEGIS_ID
ARG NEXT_PUBLIC_AEGIS_HOST_URL
ENV VITE_AEGIS_ENABLED="${VITE_AEGIS_ENABLED}"
ENV VITE_AEGIS_ID="${VITE_AEGIS_ID}"
ENV VITE_AEGIS_HOST_URL="${VITE_AEGIS_HOST_URL}"
ENV NEXT_PUBLIC_AEGIS_ENABLED="${NEXT_PUBLIC_AEGIS_ENABLED}"
ENV NEXT_PUBLIC_AEGIS_ID="${NEXT_PUBLIC_AEGIS_ID}"
ENV NEXT_PUBLIC_AEGIS_HOST_URL="${NEXT_PUBLIC_AEGIS_HOST_URL}"

ARG VITE_POSTHOG_ENABLED=false
ARG VITE_POSTHOG_PROJECT_TOKEN
ARG VITE_POSTHOG_HOST
ARG VITE_POSTHOG_UI_HOST
ARG NEXT_PUBLIC_POSTHOG_ENABLED=false
ARG NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN
ARG NEXT_PUBLIC_POSTHOG_HOST
ARG NEXT_PUBLIC_POSTHOG_UI_HOST
ENV VITE_POSTHOG_ENABLED="${VITE_POSTHOG_ENABLED}"
ENV VITE_POSTHOG_PROJECT_TOKEN="${VITE_POSTHOG_PROJECT_TOKEN}"
ENV VITE_POSTHOG_HOST="${VITE_POSTHOG_HOST}"
ENV VITE_POSTHOG_UI_HOST="${VITE_POSTHOG_UI_HOST}"
ENV NEXT_PUBLIC_POSTHOG_ENABLED="${NEXT_PUBLIC_POSTHOG_ENABLED}"
ENV NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="${NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN}"
ENV NEXT_PUBLIC_POSTHOG_HOST="${NEXT_PUBLIC_POSTHOG_HOST}"
ENV NEXT_PUBLIC_POSTHOG_UI_HOST="${NEXT_PUBLIC_POSTHOG_UI_HOST}"

RUN corepack enable \
  && corepack prepare pnpm@10.23.0 --activate \
  && pnpm install --frozen-lockfile \
  && pnpm build

FROM nginx:1.27-alpine
COPY frontend/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/frontend/out /usr/share/nginx/html
EXPOSE 8080
