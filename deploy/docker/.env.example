# Copy to .env and choose private host directories owned by the deployment user.
# Container paths match the canonical layout in docker/README.md.
OPENCRAFT_HOST_DATA_DIR=/srv/opencraft/state
OPENCRAFT_DATA_DIR=/var/lib/opencraft
OPENCRAFT_HOST_WORKSPACE_DIR=/srv/opencraft/workspaces
OPENCRAFT_WORKSPACE_DIR=/workspace
OPENCRAFT_HOST_LOG_DIR=/srv/opencraft/logs
OPENCRAFT_LOG_DIR=/var/log/opencraft
OPENCRAFT_UID=1000
OPENCRAFT_GID=1000
OPENCRAFT_PORT=10000
OPENCRAFT_IMAGE=opencraft:local
OPENCRAFT_PLATFORM=linux/amd64
# Optional: use compose.owned-electron.yaml for a verified custom browser.
# OPENCRAFT_BROWSER_ELECTRON_DISTRIBUTION=/absolute/path/to/verified/browser
OPENCRAFT_HANDS_CPUS=4.0
OPENCRAFT_HANDS_MEMORY_BYTES=8589934592

# Native Pi uses the shared Assets authority. Explicit legacy product assembly only:
# OPENCRAFT_EXECUTION_CONTEXT=legacy
OPENCRAFT_EXECUTION_CONTEXT=assets

# Opaque account ENV delivery to DSH and Pi (Assets context only). Changing the
# generation rotates the issuer key; Brain then relaunches DSH and Pi.
# OPENCRAFT_ENVIRONMENT_DELIVERY=vault-owner
# OPENCRAFT_ENVIRONMENT_ISSUER_GENERATION=1
