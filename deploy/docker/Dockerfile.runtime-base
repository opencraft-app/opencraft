# syntax=docker/dockerfile:1
# Product-owned OS dependencies shared by Join's Gateway, Brain, Hands and full images.
ARG RUNTIME_BASE_IMAGE=debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
FROM ${RUNTIME_BASE_IMAGE} AS runtime-base
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
