# Copy to site.env. No registry/account/model credentials belong in this file.
COMPOSE_PROJECT_NAME=opencraft
OPENCRAFT_UID=1000
OPENCRAFT_GID=1000
OPENCRAFT_HOST_DATA_DIR=/srv/opencraft/state
OPENCRAFT_HOST_EXECUTION_DIR=/srv/opencraft/hands-ipc/client
OPENCRAFT_HOST_WORKSPACE_DIR=/srv/opencraft/workspace
OPENCRAFT_HOST_LOG_DIR=/srv/opencraft/logs
# Stable container paths. Preserve these when moving to another machine.
OPENCRAFT_DATA_DIR=/var/lib/opencraft
OPENCRAFT_EXECUTION_DIR=/var/lib/opencraft/execution
OPENCRAFT_WORKSPACE_DIR=/workspace
OPENCRAFT_LOG_DIR=/var/log/opencraft
OPENCRAFT_BIND_HOST=127.0.0.1
OPENCRAFT_PORT=11080
OPENCRAFT_PROXY_PORT=46071
# Enforced container limits and the budgets the Gateway requests through
# static-docker; deploy.py rejects a declared budget that differs from the limit.
OPENCRAFT_HANDS_CPUS=2
OPENCRAFT_HANDS_MEMORY_BYTES=4294967296
OPENCRAFT_BRAIN_CPUS=2
OPENCRAFT_BRAIN_MEMORY_BYTES=4294967296
# Optional opaque account ENV delivery to DSH, Pi and Codex (`vault-owner` is an
# alias). Gateway and Brain both receive it; deploy.py rejects a mismatch.
# OPENCRAFT_ENVIRONMENT_DELIVERY=opaque
# Rotate the Gateway vault owner's issuer key only by changing this explicitly.
# OPENCRAFT_ENVIRONMENT_ISSUER_GENERATION=

# Standard root execution; Gateway/Brain/Proxy and Chromium remain nonroot.
# Requires a newly verified Hands image with the formal root/client bridge.
OPENCRAFT_HANDS_ROOT=1
# For root mode set HOST_EXECUTION_DIR to HOST_HANDS_ROOT_DIR/client.
OPENCRAFT_HOST_HANDS_ROOT_DIR=/srv/opencraft/hands-ipc
# OPENCRAFT_HANDS_SERVER_NAME=server
# OPENCRAFT_HANDS_CLIENT_NAME=client
# Optional retained Hands alias (e.g. /var/lib/opencraft/client-execution).
# OPENCRAFT_HANDS_PUBLIC_CLIENT_DIRECTORY=/var/lib/opencraft/execution

# Retain an old Chromium profile in the client root only when explicitly migrating.
# OPENCRAFT_HANDS_BROWSER_NAME=.
# For a retained browser profile at the common filesystem root, independent of
# new sibling root/client IPC directories, declare its existing in-container path.
# OPENCRAFT_HANDS_BROWSER_DIRECTORY=/run/opencraft-hands
# For that retained layout, also declare the client-visible browser path (the
# Gateway reaches the browser only as a workspace endpoint, never by socket path):
# OPENCRAFT_BROWSER_DATA_DIR=/var/lib/opencraft/execution
# Optional independent root-owned Hands logs; never re-own retained client logs.
# OPENCRAFT_HOST_HANDS_LOG_DIR=/srv/opencraft/logs/hands-root
# Retained absolute workspace identities can be configured without moving files.
# OPENCRAFT_CODEX_PROJECTLESS_DIR=/workspace/sessions/codex
# OPENCRAFT_DSH_PROJECTLESS_DIR=/workspace/sessions/dsh

# Matched Gateway/Brain/Hands personal Git protocol; independent of root mode.
OPENCRAFT_PERSONAL_GIT=1
OPENCRAFT_HOST_GIT_RUNTIME_DIR=/srv/opencraft/git-ipc
OPENCRAFT_GIT_RUNTIME_DIRECTORY=/var/lib/opencraft/git-credentials
OPENCRAFT_GIT_HOSTS=github.com
