# Relaunch the independent execution owners so they pin the published issuer
# key at launch (their configuration names `environmentIssuerFile`): Pi, DSH
# and, with its environment drop-in, the split Codex AppServer.
[Unit]
Description=Relaunch OpenCraft execution owners with the current ENV issuer

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl try-restart opencraft-engine-host.service opencraft-dsh-host.service opencraft-codex-appserver.service
