// Million-Scale Hosted Cloud Relay Wrangler deployment template.
//
// Architecture:
// - Stateless Edge Worker: serves Workbench static assets (`ASSETS`), computes
//   Argon2id password hashes across parallel edge isolates, verifies HS256 JWT
//   sessions + Ed25519 DPoP proofs in <0.1ms, and streams large blobs directly
//   to/from R2 (`RELAY_BLOBS`).
// - IdentityIndexDO (4,096 shards `idx:000`..`idx:fff`): atomic `(provider, subject) -> actorId` uniqueness.
// - UserRelayDO (1 per human Actor `user:<actorId>`): personal machine ledger, quotas, pairing codes & ShareGrants.
// - MachineRelayDO (1 per machine `machine:<machineId>`): 100% WebSocket-hibernated `opencraft-relay.v2` multiplexer.
//
// Required secret before deploying:
//   wrangler secret put OPENCRAFT_RELAY_SIGNING_KEY --config deploy/cloudflare/wrangler.cloud-relay.jsonc
{
  "name": "opencraft-cloud-relay",
  "main": "../../apps/relay-server/src/cloudflare/deployment-worker.mjs",
  "compatibility_date": "2026-11-01",
  // Uncomment after building hostless Workbench assets (`scripts/cloudflare/prepare-workbench-assets.mjs`):
  // "assets": { "directory": "./workbench-assets", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": {
    "bindings": [
      { "name": "IDENTITY_INDEX", "class_name": "IdentityIndexDO" },
      { "name": "USER_RELAY", "class_name": "UserRelayDO" },
      { "name": "MACHINE_RELAY", "class_name": "MachineRelayDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IdentityIndexDO", "UserRelayDO", "MachineRelayDO"] }
  ],
  "r2_buckets": [
    { "binding": "RELAY_BLOBS", "bucket_name": "opencraft-relay-blobs" }
  ],
  "vars": {
    "OPENCRAFT_RELAY_ORIGIN": "https://relay.opencraft.app",
    "OPENCRAFT_RELAY_FREE_MACHINE_LIMIT": "3"
  }
}
