// Template: the installation's Cloudflare Workers deployment assembly
// (docs/architecture/platform/cloudflare-deployment.md §5, §5.6). Copy it,
// choose the Worker name and origin, and deploy with Wrangler from this
// directory. Nothing in this repository deploys it; validation and builds never
// touch an account.
//
// It serves the installation's identity and admission (setup, local login,
// sessions, Actors, instance membership) from one SQLite-backed Durable Object,
// InstallationCore, and the account's model usage policy, model configuration,
// sealed model credentials and credential leases from a second one,
// AccountCore. Static assets, the Client DO and WorkspaceHost are not
// assembled yet; see §5.4 and §5.6 for what a production deployment still lacks.
//
// Secrets, never vars:
//   wrangler secret put OPENCRAFT_SETUP_TOKEN --config wrangler.installation-core.jsonc
//   (43 characters of [A-Za-z0-9_-]; remove it once the first administrator exists)
//   wrangler secret put OPENCRAFT_ACCOUNT_SEALING_KEY --config wrangler.installation-core.jsonc
//   (`<id>.<base64url of 32 random bytes>`, for example the output of
//   node -e "console.log('k1.'+require('crypto').randomBytes(32).toString('base64url'))"
//   It seals every model credential AccountCore stores, so losing it loses
//   them; without a valid key AccountCore stays closed)
{
  "name": "opencraft-installation-core",
  "main": "../../apps/headless-server/src/cloudflare/worker.ts",
  // The same runtime the local workerd tests and the rehearsal use.
  "compatibility_date": "2026-07-30",
  // node:crypto and the other built-ins the installation module imports.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "INSTALLATION_CORE", "class_name": "InstallationCore" },
      { "name": "ACCOUNT_CORE", "class_name": "AccountCore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InstallationCore"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountCore"] }
  ],
  "vars": {
    // Validated like the Node Human login configuration file; `origin` is this deployment's HTTPS origin.
    "OPENCRAFT_HUMAN_AUTH": "{\"origin\":\"https://opencraft.example\",\"local\":true,\"oidc\":[]}",
    "OPENCRAFT_MACHINE_NAME": "OpenCraft"
  },
  "observability": { "enabled": true }
}
