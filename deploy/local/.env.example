# Local-only defaults for deploy/local/docker-compose.yml.
# These are development values. Do not put real cloud keys or production
# database credentials in this file.

LOCAL_STACK_PLATFORM=linux/arm64

LOCAL_MYSQL_PORT=43306
LOCAL_REDIS_PORT=36379
LOCAL_SERVICE_GATEWAY_PORT=8085
LOCAL_FRONTEND_PORT=5173
LOCAL_AUTH_PORT=28081
LOCAL_FAKE_QQ_OAUTH_PORT=19010
LOCAL_SANDBOX_PORT=18081
LOCAL_PAYMENT_PORT=18082
LOCAL_SUBSCRIPTION_PORT=8086
LOCAL_AI_GATEWAY_PORT=18080
LOCAL_PORTKEY_PORT=8787

LOCAL_MYSQL_ROOT_PASSWORD=local_root_password
LOCAL_REDIS_PASSWORD=local_redis_password
LOCAL_LIGHTCLAW_AUTH_DB_PASSWORD=local_lightclaw_auth
LOCAL_PAYMENT_DB_PASSWORD=local_payment
LOCAL_SUBSCRIPTION_DB_PASSWORD=local_subscription
LOCAL_AI_GATEWAY_DB_PASSWORD=local_ai_gateway
LOCAL_SANDBOX_DB_PASSWORD=local_sandbox

LOCAL_INTERNAL_SERVICE_TOKEN=local-internal-token
LOCAL_ADMIN_TOKEN=local-admin-token
LOCAL_AUTH_ADMIN_TOKEN=local-auth-admin-token
LOCAL_SUBSCRIPTION_ADMIN_TOKEN=local-subscription-admin-token
LOCAL_QQ_APP_ID=local-qq-app-id
LOCAL_QQ_APP_KEY=local-qq-app-key
LOCAL_FAKE_QQ_DEFAULT_USER=local
LOCAL_GATEWAY_ADMIN_USER=admin
LOCAL_GATEWAY_ADMIN_PASSWORD=local-admin-password
LOCAL_AI_GATEWAY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
LOCAL_REGISTRY_TOKEN=local-registry-token
LOCAL_E2E_AUTH_TOKEN=local-e2e-token
LOCAL_SHADOW_BINDING_INTERNAL_TOKEN=local-shadow-binding-token
LOCAL_VIBEBASE_INTERNAL_TOKEN=local-vibebase-token

LOCAL_FRONTEND_SCRIPT=dev:global
LOCAL_FRONTEND_API_BASE_URL=http://localhost:8085
