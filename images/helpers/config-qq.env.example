# =============================================================================
# OpenClaw QQ 消息通道配置文件模板
#
# 复制此文件为 config-qq.env 并填入实际值:
#   cp config-qq.env.example config-qq.env
#
# 注意: config-qq.env 包含敏感信息，请勿提交到 git
# =============================================================================

# ---- 必填 ----

# QQBot Token，格式: AppID:AppSecret
# 获取方式:
#   1. 访问 QQ 开放平台: https://q.qq.com/
#   2. 创建机器人应用
#   3. 获取 AppID 和 AppSecret
#   4. 拼接格式: AppID:AppSecret
QQBOT_TOKEN="123456789:your-app-secret-here"

# ---- 可选 ----

# 测试消息目标（群号或用户ID，用于 --test 模式）
TEST_TARGET=""
