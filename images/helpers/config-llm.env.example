# =============================================================================
# OpenClaw 大模型 API 配置文件模板
#
# 复制此文件为 config-llm.env 并填入实际值:
#   cp config-llm.env.example config-llm.env
#
# 注意: config-llm.env 包含敏感信息，请勿提交到 git
# =============================================================================

# ---- 必填 ----

# 大模型 API Base URL
CUSTOM_BASE_URL="https://api.lkeap.cloud.tencent.com/coding/v3"

# 模型 ID
CUSTOM_MODEL_ID="glm-5"

# 兼容性模式: openai 或 anthropic
CUSTOM_COMPATIBILITY="openai"

# ---- 可选 ----

# API Key（留空则跳过健康检查）
CUSTOM_API_KEY=""

# Provider ID（默认自动生成）
CUSTOM_PROVIDER_ID=""

# Gateway 端口（默认: 18789）
GATEWAY_PORT=18789
