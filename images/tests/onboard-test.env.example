# =============================================================================
# OpenClaw Onboard E2E 测试配置文件
#
# 复制此文件为 onboard-test.env 并填入你的实际值:
#   cp onboard-test.env.example onboard-test.env
#
# 注意: onboard-test.env 包含敏感信息，请勿提交到 git
# =============================================================================

# ---- 必填 ----

# Custom provider API base URL
CUSTOM_BASE_URL="https://api.lkeap.cloud.tencent.com/coding/v3"

# 模型 ID
CUSTOM_MODEL_ID="glm-5"

# 兼容性模式: openai 或 anthropic
CUSTOM_COMPATIBILITY="openai"

# ---- 可选 ----

# API key（留空则跳过 gateway 健康检查和 agent 烟雾测试）
CUSTOM_API_KEY=""

# Provider ID（默认: custom-test-provider）
CUSTOM_PROVIDER_ID="custom-test-provider"

# Gateway 端口（默认: 18789）
GATEWAY_PORT=18789

# Telegram bot token（留空则不配置 Telegram 渠道）
TELEGRAM_BOT_TOKEN=""

# QQBot token，格式为 AppID:AppSecret（留空则不配置 QQBot 渠道）
QQBOT_TOKEN=""
