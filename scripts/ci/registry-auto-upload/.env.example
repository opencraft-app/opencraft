# Copy to /opt/opencraft-docker/registry-upload/.env (root:root, mode 0600).
# Values containing shell metacharacters must be quoted. No shell tracing.
# Explicit destination, without a tag or digest.
REGISTRY_REPOSITORY='registry.example.com/team/opencraft'
REGISTRY_USERNAME=''
REGISTRY_PASSWORD=''
OPENCRAFT_NODE=/usr/bin/node
RELEASE_STATE=/opt/opencraft-docker/fast-release-state
UPLOAD_STATE=/var/lib/opencraft-registry-upload
# Set to installation time, or the updatedAt of a selected successful release.
UPLOAD_SINCE=''
